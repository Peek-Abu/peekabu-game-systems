local StateSyncWorldStore = require(script.Parent.StateSyncWorldStore)

return function()
	afterEach(function()
		StateSyncWorldStore.clear("spec-a")
		StateSyncWorldStore.clear("spec-b")
	end)

	it("serves every set entry by name", function()
		StateSyncWorldStore.set("spec-a", { phase = "lobby" })
		StateSyncWorldStore.set("spec-b", 3)
		local map = StateSyncWorldStore.getter()()
		expect(map["spec-a"].phase).to.equal("lobby")
		expect(map["spec-b"]).to.equal(3)
		expect(StateSyncWorldStore.get("spec-b")).to.equal(3)
	end)

	it("replaces an entry and gives the map a new identity", function()
		StateSyncWorldStore.set("spec-a", 1)
		local before = StateSyncWorldStore.getter()()
		StateSyncWorldStore.set("spec-a", 2)
		local after = StateSyncWorldStore.getter()()
		expect(after).never.to.equal(before)
		expect(after["spec-a"]).to.equal(2)
	end)

	it("clear removes the entry and is a no-op for an absent one", function()
		StateSyncWorldStore.set("spec-a", true)
		StateSyncWorldStore.clear("spec-a")
		StateSyncWorldStore.clear("spec-a")
		expect(StateSyncWorldStore.get("spec-a")).to.equal(nil)
		expect(StateSyncWorldStore.getter()()["spec-a"]).to.equal(nil)
	end)
end
