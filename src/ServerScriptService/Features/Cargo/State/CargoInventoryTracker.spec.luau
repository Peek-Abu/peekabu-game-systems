local CargoInventoryTracker = require(script.Parent.CargoInventoryTracker)

local function entry(kind, value)
	return { kind = kind, value = value or 10 }
end

return function()
	describe("item slots", function()
		it("puts entries in the first free slot and finds the next one", function()
			local tracker = CargoInventoryTracker.new()
			expect(tracker:firstFree(1)).to.equal(1)
			expect(tracker:put(1, 1, entry("plaque"))).to.equal(true)
			expect(tracker:firstFree(1)).to.equal(2)
			expect(tracker:put(1, 3, entry("keyring"))).to.equal(true)
			expect(tracker:firstFree(1)).to.equal(2)
		end)

		it("refuses an occupied or missing slot", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 2, entry("plaque"))
			expect(tracker:put(1, 2, entry("keyring"))).to.equal(false)
			expect(tracker:put(1, 0, entry("keyring"))).to.equal(false)
			expect(tracker:put(1, 5, entry("keyring"))).to.equal(false)
		end)

		it("has no free slot once all four are full", function()
			local tracker = CargoInventoryTracker.new()
			for index = 1, 4 do
				tracker:put(7, index, entry("coffeeMug"))
			end
			expect(tracker:firstFree(7)).to.equal(nil)
			expect(tracker:count(7)).to.equal(4)
		end)

		it("hands out copies", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 1, { kind = "plaque", value = 10, appraisal = { base = 60, clean = 0, appraised = false } })
			local slots = tracker:slots(1)
			slots[1].value = 999
			slots[1].appraisal.clean = 1
			local again = tracker:get(1, 1)
			expect(again.value).to.equal(10)
			expect(again.appraisal.clean).to.equal(0)
		end)

		it("takes one slot out, leaving the others where they are", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 1, entry("plaque"))
			tracker:put(1, 2, entry("keyring"))
			expect(tracker:take(1, 1).kind).to.equal("plaque")
			expect(tracker:get(1, 1)).to.equal(nil)
			expect(tracker:get(1, 2).kind).to.equal("keyring")
			expect(tracker:take(1, 1)).to.equal(nil)
		end)

		it("replaces a slot's entry with a fresh copy", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 1, entry("coffeeMug", 30))
			tracker:replace(1, 1, entry("coffeeMug", 15))
			expect(tracker:get(1, 1).value).to.equal(15)
		end)
	end)

	describe("the hands and the chosen slot", function()
		it("remembers which slot's item is in the hands", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 2, entry("monitor"))
			expect(tracker:hands(1)).to.equal(nil)
			tracker:setHands(1, 2)
			expect(tracker:hands(1)).to.equal(2)
			tracker:setHands(1, nil)
			expect(tracker:hands(1)).to.equal(nil)
		end)

		it("lists only the pocketed entries, in slot order, without the hands item", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 3, entry("keyring"))
			tracker:put(1, 1, entry("plaque"))
			tracker:put(1, 2, entry("monitor"))
			tracker:setHands(1, 2)
			local pocketed = tracker:pocketed(1)
			expect(#pocketed).to.equal(2)
			expect(pocketed[1].kind).to.equal("plaque")
			expect(pocketed[2].kind).to.equal("keyring")
		end)

		it("remembers the chosen hotbar slot (0 by default)", function()
			local tracker = CargoInventoryTracker.new()
			expect(tracker:selected(1)).to.equal(0)
			tracker:setSelected(1, 4)
			expect(tracker:selected(1)).to.equal(4)
		end)
	end)

	describe("emptying", function()
		it("takes everything for a Load or a scatter, the hands slot forgotten too", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 1, entry("plaque"))
			tracker:put(1, 2, entry("monitor"))
			tracker:put(1, 4, entry("keyring"))
			tracker:setHands(1, 2)
			local taken = tracker:takePocketed(1)
			expect(#taken).to.equal(2)
			expect(taken[1].kind).to.equal("plaque")
			expect(taken[2].kind).to.equal("keyring")
			expect(tracker:count(1)).to.equal(0)
			expect(tracker:hands(1)).to.equal(nil)
		end)

		it("forgets one player, or everyone", function()
			local tracker = CargoInventoryTracker.new()
			tracker:put(1, 1, entry("plaque"))
			tracker:put(2, 1, entry("plaque"))
			tracker:setSelected(1, 3)
			tracker:forget(1)
			expect(tracker:count(1)).to.equal(0)
			expect(tracker:selected(1)).to.equal(0)
			expect(tracker:count(2)).to.equal(1)
			tracker:clear()
			expect(tracker:count(2)).to.equal(0)
		end)
	end)
end
