local AnalyticsVisitTracker = require(script.Parent.AnalyticsVisitTracker)

return function()
	it("an unknown player is in the shift with nothing noted", function()
		local tracker = AnalyticsVisitTracker.new()
		expect(tracker:placeOf(1)).to.equal("shift")
		expect(next(tracker:momentsOf(1))).to.equal(nil)
		expect(tracker:isLeaving(1)).to.equal(false)
		expect(tracker:isAgain(1)).to.equal(false)
		expect(tracker:takeHub(1)).to.equal(nil)
		local shifts = tracker:shiftsOf(1)
		expect(shifts.visit).to.equal(0)
		expect(shifts.lifetime).to.equal(0)
	end)

	it("keeps the place, the moments and the leaving flag", function()
		local tracker = AnalyticsVisitTracker.new()
		tracker:setPlace(1, "results")
		tracker:note(1, "caught", 50)
		tracker:note(1, "caught", 70)
		tracker:setLeaving(1, true)
		expect(tracker:placeOf(1)).to.equal("results")
		expect(tracker:momentsOf(1).caught).to.equal(70)
		expect(tracker:isLeaving(1)).to.equal(true)
		tracker:setLeaving(1, false)
		expect(tracker:isLeaving(1)).to.equal(false)
	end)

	it("a hub stay is taken once", function()
		local tracker = AnalyticsVisitTracker.new()
		tracker:enterHub(1, 10)
		expect(tracker:takeHub(1)).to.equal(10)
		expect(tracker:takeHub(1)).to.equal(nil)
	end)

	it("keeps the visit's and the lifetime's shifts and whether the visit continued", function()
		local tracker = AnalyticsVisitTracker.new()
		tracker:setShifts(1, 2, 14)
		tracker:setAgain(1, true)
		expect(tracker:shiftsOf(1).visit).to.equal(2)
		expect(tracker:shiftsOf(1).lifetime).to.equal(14)
		expect(tracker:isAgain(1)).to.equal(true)
	end)

	it("a training step is marked once", function()
		local tracker = AnalyticsVisitTracker.new()
		expect(tracker:markTraining(1, 3)).to.equal(true)
		expect(tracker:markTraining(1, 3)).to.equal(false)
		expect(tracker:markTraining(2, 3)).to.equal(true)
	end)

	it("forget drops everything about the player", function()
		local tracker = AnalyticsVisitTracker.new()
		tracker:setPlace(1, "hub")
		tracker:enterHub(1, 10)
		tracker:markTraining(1, 1)
		tracker:forget(1)
		expect(tracker:placeOf(1)).to.equal("shift")
		expect(tracker:takeHub(1)).to.equal(nil)
		expect(tracker:markTraining(1, 1)).to.equal(true)
	end)
end
