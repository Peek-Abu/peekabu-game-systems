local AnalyticsContextTracker = require(script.Parent.AnalyticsContextTracker)

return function()
	it("first platform report wins and unknown is refused", function()
		local tracker = AnalyticsContextTracker.new()
		expect(tracker:setPlatform(1, "unknown")).to.equal(false)
		expect(tracker:setPlatform(1, "phone")).to.equal(true)
		expect(tracker:setPlatform(1, "pc")).to.equal(false)
		expect(tracker:platformOf(1)).to.equal("phone")
		expect(tracker:platformOf(2)).to.equal("unknown")
	end)

	it("cohort defaults to unk", function()
		local tracker = AnalyticsContextTracker.new()
		expect(tracker:cohortOf(1)).to.equal("unk")
		tracker:setCohort(1, "new")
		expect(tracker:cohortOf(1)).to.equal("new")
	end)

	it("a funnel step and the assignment log count once per player", function()
		local tracker = AnalyticsContextTracker.new()
		expect(tracker:markStep(1, 3)).to.equal(true)
		expect(tracker:markStep(1, 3)).to.equal(false)
		expect(tracker:markStep(2, 3)).to.equal(true)
		expect(tracker:markAssigned(1)).to.equal(true)
		expect(tracker:markAssigned(1)).to.equal(false)
	end)

	it("forget clears everything for that player", function()
		local tracker = AnalyticsContextTracker.new()
		tracker:setPlatform(1, "phone")
		tracker:setCohort(1, "ret")
		tracker:markStep(1, 3)
		tracker:markAssigned(1)
		tracker:forget(1)
		expect(tracker:platformOf(1)).to.equal("unknown")
		expect(tracker:cohortOf(1)).to.equal("unk")
		expect(tracker:markStep(1, 3)).to.equal(true)
		expect(tracker:markAssigned(1)).to.equal(true)
	end)
end
