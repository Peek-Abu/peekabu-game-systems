local AnalyticsVisitUtils = require(script.Parent.AnalyticsVisitUtils)

return function()
	describe("continues", function()
		it("a save loaded soon after a truck ride's stamp is the same visit", function()
			expect(AnalyticsVisitUtils.continues(1000, 1030)).to.equal(true)
			expect(AnalyticsVisitUtils.continues(1000, 1300)).to.equal(true)
		end)

		it("no stamp, an old stamp or a stamp from the future starts a new visit", function()
			expect(AnalyticsVisitUtils.continues(0, 1030)).to.equal(false)
			expect(AnalyticsVisitUtils.continues(1000, 1301)).to.equal(false)
			expect(AnalyticsVisitUtils.continues(2000, 1000)).to.equal(false)
		end)
	end)

	describe("after", function()
		it("nothing recent is nothing", function()
			expect(AnalyticsVisitUtils.after({}, 500)).to.equal("nothing")
			expect(AnalyticsVisitUtils.after({ caught = 100 }, 500)).to.equal("nothing")
		end)

		it("a recent catch, chase or knock-out is what the quit came after", function()
			expect(AnalyticsVisitUtils.after({ caught = 470 }, 500)).to.equal("caught")
			expect(AnalyticsVisitUtils.after({ chased = 440 }, 500)).to.equal("chased")
			expect(AnalyticsVisitUtils.after({ knocked_out = 499 }, 500)).to.equal("knocked_out")
		end)

		it("a knock-out beats a catch, and a catch beats a chase", function()
			expect(AnalyticsVisitUtils.after({ caught = 490, knocked_out = 480, chased = 495 }, 500)).to.equal(
				"knocked_out"
			)
			expect(AnalyticsVisitUtils.after({ caught = 480, chased = 495 }, 500)).to.equal("caught")
		end)
	end)

	describe("bucket", function()
		it("groups the lifetime shift total", function()
			expect(AnalyticsVisitUtils.bucket(0)).to.equal("0")
			expect(AnalyticsVisitUtils.bucket(1)).to.equal("1")
			expect(AnalyticsVisitUtils.bucket(2)).to.equal("2")
			expect(AnalyticsVisitUtils.bucket(3)).to.equal("3-4")
			expect(AnalyticsVisitUtils.bucket(4)).to.equal("3-4")
			expect(AnalyticsVisitUtils.bucket(5)).to.equal("5-9")
			expect(AnalyticsVisitUtils.bucket(10)).to.equal("10-24")
			expect(AnalyticsVisitUtils.bucket(25)).to.equal("25-49")
			expect(AnalyticsVisitUtils.bucket(50)).to.equal("50+")
			expect(AnalyticsVisitUtils.bucket(9999)).to.equal("50+")
		end)
	end)

	describe("seconds", function()
		it("whole seconds, never negative, capped at a day", function()
			expect(AnalyticsVisitUtils.seconds(100, 142.7)).to.equal(42)
			expect(AnalyticsVisitUtils.seconds(100, 90)).to.equal(0)
			expect(AnalyticsVisitUtils.seconds(0, 10 ^ 9)).to.equal(86400)
		end)
	end)
end
