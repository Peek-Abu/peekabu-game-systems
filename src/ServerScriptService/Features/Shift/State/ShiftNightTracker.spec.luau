local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShiftNightConstants = require(ReplicatedStorage.Shared.Features.Shift.Data.ShiftNightConstants)
local ShiftNightFormulas = require(ReplicatedStorage.Shared.Features.Shift.Utils.ShiftNightFormulas)
local ShiftNightTracker = require(script.Parent.ShiftNightTracker)

return function()
	local N = ShiftNightConstants.WEEK_NIGHTS

	-- Plays a whole week from night 1, every night met, voting Next night between them; returns the last settlement.
	local function playWeek(tracker)
		local settlement
		for night = 1, N do
			tracker:setGoal(50)
			settlement = tracker:settle(night, 60, true, false, {})
			if night < N then
				tracker:nextNight()
			end
		end
		return settlement
	end

	describe("before a run", function()
		it("needs a start and reads as a quick shift", function()
			local tracker = ShiftNightTracker.new()
			expect(tracker:needsStart()).to.equal(true)
			expect(tracker:view().runMode).to.equal("quick")
			expect(tracker:night()).to.equal(nil)
		end)
	end)

	describe("a quick run", function()
		it("has no night fields and never settles", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("quick")
			expect(tracker:needsStart()).to.equal(false)
			tracker:setGoal(100)
			local view = tracker:view()
			expect(view.runMode).to.equal("quick")
			expect(view.night).to.equal(nil)
			expect(view.weekBonus).to.equal(nil)
			expect(tracker:settle(1, 200, false, false, {})).to.equal(nil)
			expect(tracker:carried()).to.equal(nil)
		end)
	end)

	describe("a night run", function()
		it("starts on night 1 of week 1 with no week report", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			local view = tracker:view()
			expect(view.runMode).to.equal("night")
			expect(view.night).to.equal(1)
			expect(view.week).to.equal(1)
			expect(view.weekBonus).to.equal(nil)
			expect(view.runOver).to.equal(nil)
			expect(tracker:carried()).to.equal(nil)
		end)

		it("goes on after a met night and counts nights on", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			local settlement = tracker:settle(1, 70, true, false, {})
			expect(settlement.runOver).to.equal(nil)
			expect(settlement.bonus).to.equal(0)
			tracker:nextNight()
			expect(tracker:view().night).to.equal(2)
			expect(tracker:isOver()).to.equal(false)
		end)

		it("fires the crew on the first night that misses its goal", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			tracker:settle(1, 60, true, false, {})
			tracker:nextNight()
			tracker:setGoal(55)
			local settlement = tracker:settle(2, 20, false, false, {})
			expect(settlement.runOver).to.equal("fired")
			expect(tracker:isOver()).to.equal(true)
			expect(tracker:view().runOver).to.equal("fired")
			expect(tracker:view().nightReached).to.equal(2)
			expect(tracker:needsStart()).to.equal(true)
		end)

		it("settles a shift once", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			expect(tracker:settle(4, 70, true, false, {})).to.be.ok()
			expect(tracker:settle(4, 70, false, false, {})).to.equal(nil)
			expect(tracker:isOver()).to.equal(false)
		end)

		it("keeps the coats each crew member ended the night with", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			local lives = { [1] = 2, [2] = 0 }
			tracker:settle(1, 70, true, false, lives)
			lives[1] = 3
			tracker:nextNight()
			local carried = tracker:carried()
			expect(carried[1]).to.equal(2)
			expect(carried[2]).to.equal(0)
		end)

		it("shows a week report with the bonus after the week's last night, until the next night", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			local settlement = playWeek(tracker)
			expect(settlement.bonus).to.equal(ShiftNightFormulas.weekBonus(1))
			expect(settlement.runOver).to.equal(nil)
			local view = tracker:view()
			expect(view.weekBonus).to.equal(ShiftNightFormulas.weekBonus(1))
			expect(view.week).to.equal(1)
			expect(view.night).to.equal(N)
			tracker:nextNight()
			view = tracker:view()
			expect(view.weekBonus).to.equal(nil)
			expect(view.night).to.equal(N + 1)
			expect(view.week).to.equal(2)
		end)

		it("ends the run on a wipe", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			local settlement = tracker:settle(1, 10, false, true, {})
			expect(settlement.runOver).to.equal("wiped")
			expect(tracker:view().runOver).to.equal("wiped")
			expect(tracker:view().nightReached).to.equal(1)
		end)

		it("clocks out on the night it is on, once", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			tracker:settle(1, 70, true, false, {})
			tracker:nextNight()
			tracker:finish("clockout")
			tracker:finish("fired")
			expect(tracker:view().runOver).to.equal("clockout")
			expect(tracker:view().nightReached).to.equal(2)
		end)

		it("keeps every night's result", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			tracker:settle(1, 70, true, false, {})
			tracker:nextNight()
			tracker:setGoal(55)
			tracker:settle(2, 40, false, false, {})
			local nights = tracker:results()
			expect(#nights).to.equal(2)
			expect(nights[1].night).to.equal(1)
			expect(nights[1].goal).to.equal(50)
			expect(nights[1].cleared).to.equal(70)
			expect(nights[2].cleared).to.equal(40)
		end)

		it("starts afresh after a run is over", function()
			local tracker = ShiftNightTracker.new()
			tracker:start("night")
			tracker:setGoal(50)
			tracker:settle(1, 10, false, true, { [1] = 0 })
			tracker:start("night")
			tracker:setGoal(50)
			local view = tracker:view()
			expect(view.night).to.equal(1)
			expect(view.runOver).to.equal(nil)
			expect(view.weekBonus).to.equal(nil)
			expect(tracker:carried()).to.equal(nil)
			expect(#tracker:results()).to.equal(0)
		end)
	end)
end
