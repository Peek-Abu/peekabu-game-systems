local ShiftLivesTracker = require(script.Parent.ShiftLivesTracker)

return function()
	it("spends a life per catch and knocks out on the last", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 3 })
		local left, out = tracker:spend(1)
		expect(left).to.equal(2)
		expect(out).to.equal(false)
		left, out = tracker:spend(1)
		expect(left).to.equal(1)
		expect(out).to.equal(false)
		left, out = tracker:spend(1)
		expect(left).to.equal(0)
		expect(out).to.equal(true)
		expect(tracker:spend(1)).to.equal(nil)
	end)

	it("lists a player who is out", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 1, [2] = 3 })
		expect(tracker:isOut(1)).to.equal(false)
		tracker:spend(1)
		expect(tracker:isOut(1)).to.equal(true)
		expect(tracker:isOut(2)).to.equal(false)
		local out = tracker:out()
		expect(#out).to.equal(1)
		expect(out[1]).to.equal(1)
	end)

	it("returns nil for an unknown player", function()
		local tracker = ShiftLivesTracker.new()
		expect(tracker:spend(9)).to.equal(nil)
		expect(tracker:get(9)).to.equal(nil)
		expect(tracker:max(9)).to.equal(nil)
		expect(tracker:isOut(9)).to.equal(false)
	end)

	it("admits a late joiner", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 3 })
		tracker:admit(2, 3)
		expect(tracker:get(2)).to.equal(3)
	end)

	it("keeps an existing entry on admit", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 3 })
		tracker:spend(1)
		tracker:admit(1, 3)
		expect(tracker:get(1)).to.equal(2)
	end)

	it("reports the starting lives as max", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 4 })
		tracker:spend(1)
		expect(tracker:max(1)).to.equal(4)
		expect(tracker:get(1)).to.equal(3)
	end)

	it("replaces everything on reset", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 1 })
		tracker:spend(1)
		tracker:reset({ [2] = 3 })
		expect(tracker:get(1)).to.equal(nil)
		expect(tracker:isOut(1)).to.equal(false)
		expect(tracker:get(2)).to.equal(3)
	end)

	it("clears everything", function()
		local tracker = ShiftLivesTracker.new()
		tracker:reset({ [1] = 1, [2] = 3 })
		tracker:spend(1)
		tracker:clear()
		expect(tracker:get(2)).to.equal(nil)
		expect(tracker:max(2)).to.equal(nil)
		expect(#tracker:out()).to.equal(0)
	end)
end
