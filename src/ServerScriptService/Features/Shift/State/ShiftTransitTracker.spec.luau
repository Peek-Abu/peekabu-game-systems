local ShiftTransitTracker = require(script.Parent.ShiftTransitTracker)

return function()
	describe("hold", function()
		it("holds each player under one new id, not yet built", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7, 8 }, 100, 15)
			expect(tracker:isHeld(7)).to.equal(true)
			expect(tracker:isHeld(8)).to.equal(true)
			expect(tracker:isHeld(9)).to.equal(false)
			local list = tracker:list()
			expect(#list).to.equal(2)
			expect(list[1].userId).to.equal(7)
			expect(list[1].id).to.equal(id)
			expect(list[1].built).to.equal(false)
		end)

		it("gives every hold a new id, and re-holding a player moves them to it", function()
			local tracker = ShiftTransitTracker.new()
			local first = tracker:hold({ 7 }, 0, 15)
			local second = tracker:hold({ 7, 8 }, 1, 15)
			expect(second).never.to.equal(first)
			expect(tracker:idOf(7)).to.equal(second)
			expect(#tracker:list()).to.equal(2)
		end)

		it("joins one player to a hold already running", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7 }, 0, 15)
			expect(tracker:join(8, id)).to.equal(true)
			expect(tracker:idOf(8)).to.equal(id)
			expect(tracker:join(9, id + 50)).to.equal(false)
		end)
	end)

	describe("place and ready", function()
		it("takes a ready report only for the player's built hold, once", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7 }, 0, 15)
			expect(tracker:markReady(7, id)).to.equal(false)
			tracker:place(7, Vector3.new(1, 2, 3), 99)
			local hold = tracker:list()[1]
			expect(hold.built).to.equal(true)
			expect(hold.seed).to.equal(99)
			expect(hold.spot).to.equal(Vector3.new(1, 2, 3))
			expect(tracker:markReady(7, id + 1)).to.equal(false)
			expect(tracker:markReady(8, id)).to.equal(false)
			expect(tracker:markReady(7, id)).to.equal(true)
			expect(tracker:markReady(7, id)).to.equal(false)
		end)

		it("forgets a ready player's hold from the published list", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7, 8 }, 0, 15)
			tracker:place(7, Vector3.zero, nil)
			tracker:markReady(7, id)
			local list = tracker:list()
			expect(#list).to.equal(1)
			expect(list[1].userId).to.equal(8)
			expect(tracker:isHeld(7)).to.equal(true)
		end)
	end)

	describe("status", function()
		it("waits until every player of the hold is ready", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7, 8 }, 0, 15)
			tracker:place(7, Vector3.zero, nil)
			tracker:place(8, Vector3.zero, nil)
			expect(tracker:status(id, 1)).to.equal("waiting")
			tracker:markReady(7, id)
			expect(tracker:status(id, 1)).to.equal("waiting")
			tracker:markReady(8, id)
			expect(tracker:status(id, 1)).to.equal("ready")
		end)

		it("times out at the hold's deadline", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7 }, 10, 15)
			expect(tracker:status(id, 24.9)).to.equal("waiting")
			expect(tracker:status(id, 25)).to.equal("timeout")
		end)

		it("is empty once everyone held has gone", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7 }, 0, 15)
			expect(tracker:release(7)).to.equal(true)
			expect(tracker:release(7)).to.equal(false)
			expect(tracker:status(id, 1)).to.equal("empty")
		end)

		it("lists who is not ready yet", function()
			local tracker = ShiftTransitTracker.new()
			local id = tracker:hold({ 7, 8 }, 0, 15)
			tracker:place(7, Vector3.zero, nil)
			tracker:markReady(7, id)
			local late = tracker:unready(id)
			expect(#late).to.equal(1)
			expect(late[1]).to.equal(8)
			expect(#tracker:members(id)).to.equal(2)
		end)
	end)

	it("clears everything", function()
		local tracker = ShiftTransitTracker.new()
		tracker:hold({ 7 }, 0, 15)
		tracker:clear()
		expect(tracker:isHeld(7)).to.equal(false)
		expect(#tracker:list()).to.equal(0)
	end)
end
