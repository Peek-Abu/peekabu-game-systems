local ShiftNightAnalyticsUtils = require(script.Parent.ShiftNightAnalyticsUtils)

return function()
	local function allNamed(record)
		expect(string.match(record.event, "^night_shift_[a-z_]+$")).to.be.ok()
		for _, field in record.fields do
			expect(type(field)).to.equal("string")
			expect(#field <= 40).to.equal(true)
		end
		expect(#record.fields <= 3).to.equal(true)
	end

	describe("mode", function()
		it("names the mode the crew departed with", function()
			local night = ShiftNightAnalyticsUtils.mode("night")
			expect(night.event).to.equal("night_shift_mode")
			expect(night.fields[1]).to.equal("night")
			expect(ShiftNightAnalyticsUtils.mode("quick").fields[1]).to.equal("quick")
			allNamed(night)
		end)
	end)

	describe("night", function()
		it("reports the night reached as the value, its week in a field", function()
			local record = ShiftNightAnalyticsUtils.night(7)
			expect(record.event).to.equal("night_shift_night")
			expect(record.value).to.equal(7)
			expect(record.fields[1]).to.equal("night_7")
			expect(record.fields[2]).to.equal("week_2")
			allNamed(record)
		end)

		it("caps the night and week fields so they stay a short list", function()
			local record = ShiftNightAnalyticsUtils.night(500)
			expect(record.value).to.equal(500)
			expect(record.fields[1]).to.equal(`night_{ShiftNightAnalyticsUtils.NIGHT_CAP}_plus`)
			expect(record.fields[2]).to.equal(`week_{ShiftNightAnalyticsUtils.WEEK_CAP}_plus`)
		end)
	end)

	describe("runEnd", function()
		it("reports how the run ended and the night it ended on", function()
			for _, reason in { "fired", "wiped", "clockout" } do
				local record = ShiftNightAnalyticsUtils.runEnd(reason, 4)
				expect(record.event).to.equal("night_shift_run_end")
				expect(record.value).to.equal(4)
				expect(record.fields[1]).to.equal(reason)
				expect(record.fields[2]).to.equal("night_4")
				allNamed(record)
			end
		end)
	end)

	describe("weekDone", function()
		it("reports the week completed and its bonus", function()
			local record = ShiftNightAnalyticsUtils.weekDone(2, 300)
			expect(record.event).to.equal("night_shift_week_done")
			expect(record.value).to.equal(2)
			expect(record.fields[1]).to.equal("week_2")
			expect(record.fields[2]).to.equal("bonus_300")
			allNamed(record)
		end)
	end)

	describe("vote", function()
		it("reports the vote's result on the night it was cast", function()
			local next = ShiftNightAnalyticsUtils.vote(false, 3)
			expect(next.event).to.equal("night_shift_vote")
			expect(next.value).to.equal(3)
			expect(next.fields[1]).to.equal("next_night")
			expect(next.fields[2]).to.equal("night_3")
			expect(ShiftNightAnalyticsUtils.vote(true, 3).fields[1]).to.equal("clock_out")
			allNamed(next)
		end)
	end)

	it("never reports a night below 1", function()
		expect(ShiftNightAnalyticsUtils.night(0).value).to.equal(1)
		expect(ShiftNightAnalyticsUtils.night(0).fields[1]).to.equal("night_1")
	end)
end
