local CarryHoldTracker = require(script.Parent.CarryHoldTracker)

return function()
	it("records a hold both ways", function()
		local tracker = CarryHoldTracker.new()
		expect(tracker:hold(1, 10)).to.equal(true)
		expect(tracker:heldBy(1)).to.equal(10)
		expect(tracker:holderOf(10)).to.equal(1)
	end)

	it("refuses a second object for the same player", function()
		local tracker = CarryHoldTracker.new()
		tracker:hold(1, 10)
		expect(tracker:hold(1, 11)).to.equal(false)
		expect(tracker:heldBy(1)).to.equal(10)
	end)

	it("refuses an object someone else holds", function()
		local tracker = CarryHoldTracker.new()
		tracker:hold(1, 10)
		expect(tracker:hold(2, 10)).to.equal(false)
		expect(tracker:holderOf(10)).to.equal(1)
	end)

	it("release frees both sides and returns the object", function()
		local tracker = CarryHoldTracker.new()
		tracker:hold(1, 10)
		expect(tracker:release(1)).to.equal(10)
		expect(tracker:heldBy(1)).to.equal(nil)
		expect(tracker:holderOf(10)).to.equal(nil)
		expect(tracker:release(1)).to.equal(nil)
	end)

	it("an object can be picked up again after release", function()
		local tracker = CarryHoldTracker.new()
		tracker:hold(1, 10)
		tracker:release(1)
		expect(tracker:hold(2, 10)).to.equal(true)
	end)
end
