local ServerScriptService = game:GetService("ServerScriptService")
local OfficeSurfaceUtils = require(script.Parent.OfficeSurfaceUtils)
local OfficeConstants = require(ServerScriptService.Features.Office.Data.OfficeConstants)

return function()
	describe("canHideUnder", function()
		it("needs HUG_FREE_MIN of clear room on every axis", function()
			expect(OfficeSurfaceUtils.canHideUnder(OfficeConstants.DESK_SIZE)).to.equal(true)
			expect(OfficeSurfaceUtils.canHideUnder(Vector3.new(8.25, 5.115, 4.95))).to.equal(true)
			expect(OfficeSurfaceUtils.canHideUnder(OfficeConstants.TABLE_SIZE)).to.equal(false)
			expect(OfficeSurfaceUtils.canHideUnder(Vector3.new(8.25, 2.97, 4.95))).to.equal(false)
			expect(OfficeSurfaceUtils.canHideUnder(Vector3.new(3, 6, 6))).to.equal(false)
		end)
	end)

	describe("surfaceOnPart", function()
		it("stands on the art's support height when the part has one, else nowhere", function()
			local frame = CFrame.new(10, 4, 20)
			local at = OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), 3)
			expect(at.Position).to.equal(Vector3.new(10, 3, 20))
			expect(OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), nil)).to.equal(nil)
			expect(OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), "x")).to.equal(nil)
		end)
	end)
end
