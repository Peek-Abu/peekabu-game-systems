local ServerScriptService = game:GetService("ServerScriptService")
local OfficeSurfaceUtils = require(script.Parent.OfficeSurfaceUtils)
local OfficeConstants = require(ServerScriptService.Features.Office.Data.OfficeConstants)

return function()
	describe("canHideUnder", function()
		it("needs HUG_FREE_MIN of clear room in the free box under the furniture, not in its outer size", function()
			expect(OfficeSurfaceUtils.canHideUnder("desk", OfficeConstants.DESK_SIZE)).to.equal(true)
			expect(OfficeSurfaceUtils.canHideUnder("table", Vector3.new(8.25, 5.115, 4.95))).to.equal(true)
			expect(OfficeSurfaceUtils.canHideUnder("table", OfficeConstants.TABLE_SIZE)).to.equal(false)
			expect(OfficeSurfaceUtils.canHideUnder("table", Vector3.new(8.25, 2.97, 4.95))).to.equal(false)
			expect(OfficeSurfaceUtils.canHideUnder("table", Vector3.new(3, 6, 6))).to.equal(false)
		end)
		it("refuses a table whose outer size passes but whose top and brace leave too little room under it", function()
			-- 4.4 tall: the outer box clears HUG_FREE_MIN (4.2), the space under the brace (0.85 of it, 3.75) does not.
			expect(OfficeSurfaceUtils.canHideUnder("table", Vector3.new(5, 4.4, 4.4))).to.equal(false)
		end)
		it("lets a kind with no free box (the cabinet: inside, not under) through", function()
			expect(OfficeSurfaceUtils.canHideUnder("cabinet", Vector3.new(1, 1, 1))).to.equal(true)
		end)
	end)

	describe("surfaceOnPart", function()
		it("stands on the art's support height when the part has one, else nowhere", function()
			local frame = CFrame.new(10, 4, 20)
			local at = OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), 3)
			expect(at.Position).to.equal(Vector3.new(10, 3, 20))
			expect(OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), nil)).to.equal(nil)
			expect(OfficeSurfaceUtils.surfaceOnPart(frame, Vector3.new(8, 8, 4), "x")).to.equal(nil)
		end)
	end)
end
