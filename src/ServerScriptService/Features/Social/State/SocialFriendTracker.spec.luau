local SocialFriendTracker = require(script.Parent.SocialFriendTracker)

return function()
	describe("SocialFriendTracker", function()
		it("knows a pair both ways once set", function()
			local tracker = SocialFriendTracker.new()
			expect(tracker:areFriends(1, 2)).to.equal(false)
			tracker:set(1, 2, true)
			expect(tracker:areFriends(1, 2)).to.equal(true)
			expect(tracker:areFriends(2, 1)).to.equal(true)
			tracker:set(2, 1, false)
			expect(tracker:areFriends(1, 2)).to.equal(false)
		end)

		it("finds a friend among others, never the player themselves", function()
			local tracker = SocialFriendTracker.new()
			tracker:set(1, 3, true)
			expect(tracker:anyFriend(1, { 1, 2 })).to.equal(false)
			expect(tracker:anyFriend(1, { 1, 2, 3 })).to.equal(true)
			expect(tracker:anyFriend(3, { 1 })).to.equal(true)
			expect(tracker:anyFriend(2, { 1, 3 })).to.equal(false)
		end)

		it("forgets everyone a leaver was paired with", function()
			local tracker = SocialFriendTracker.new()
			tracker:set(1, 2, true)
			tracker:set(1, 3, true)
			tracker:forget(1)
			expect(tracker:areFriends(2, 1)).to.equal(false)
			expect(tracker:areFriends(3, 1)).to.equal(false)
		end)

		it("has one shared instance for the server", function()
			expect(SocialFriendTracker.shared).to.be.ok()
			expect(SocialFriendTracker.shared.areFriends).to.be.a("function")
		end)
	end)
end
