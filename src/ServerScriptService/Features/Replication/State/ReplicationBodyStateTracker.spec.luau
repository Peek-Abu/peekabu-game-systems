local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicationStateTimingUtils =
	require(ReplicatedStorage.Shared.Features.Replication.Utils.ReplicationStateTimingUtils)
local ReplicationBodyStateTracker = require(ServerScriptService.Features.Replication.State.ReplicationBodyStateTracker)

local MAX_OPEN = ReplicationStateTimingUtils.MAX_OPEN_STATE_MS

return function()
	describe("set", function()
		it("creates a state and reads it back", function()
			local store = ReplicationBodyStateTracker.new()
			expect(ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)).to.equal("created")
			local entry = ReplicationBodyStateTracker.get(store, 1, "full", 1100)
			expect(entry.data).to.equal("leap")
			expect(entry.startMs).to.equal(1000)
			expect(entry.durationMs).to.equal(500)
			expect(store.counters.created).to.equal(1)
		end)

		it("replaces the state on the same key", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			expect(ReplicationBodyStateTracker.set(store, 1, "full", "guard", 1100, 300, 1100)).to.equal("replaced")
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1100).data).to.equal("guard")
			expect(store.counters.replaced).to.equal(1)
		end)

		it("holds one state per key and several keys per body", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			ReplicationBodyStateTracker.set(store, 1, "upper", "pose", 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1100).data).to.equal("leap")
			expect(ReplicationBodyStateTracker.get(store, 1, "upper", 1100).data).to.equal("pose")
			expect(#ReplicationBodyStateTracker.active(store, 1, 1100)).to.equal(2)
		end)

		it("keeps bodies apart", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			ReplicationBodyStateTracker.set(store, 2, "full", "guard", 1000, 500, 1000)
			ReplicationBodyStateTracker.clear(store, 1, "full", 1100)
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1100)).to.equal(nil)
			expect(ReplicationBodyStateTracker.get(store, 2, "full", 1100).data).to.equal("guard")
		end)
	end)

	describe("clear", function()
		it("returns the cleared live state, so the shell can send a stop", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			local entry = ReplicationBodyStateTracker.clear(store, 1, "full", 1100)
			expect(entry.startMs).to.equal(1000)
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1100)).to.equal(nil)
			expect(store.counters.cleared).to.equal(1)
		end)

		it("returns nil for a key that holds nothing", function()
			local store = ReplicationBodyStateTracker.new()
			expect(ReplicationBodyStateTracker.clear(store, 1, "full", 1000)).to.equal(nil)
		end)

		it("returns nil for a state that already ran out (no stop is owed)", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			expect(ReplicationBodyStateTracker.clear(store, 1, "full", 1600)).to.equal(nil)
			expect(store.counters.expired).to.equal(1)
		end)
	end)

	describe("lazy expiry", function()
		it("drops a timed state once its duration has run out", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1499)).to.be.ok()
			expect(ReplicationBodyStateTracker.get(store, 1, "full", 1500)).to.equal(nil)
			expect(store.counters.expired).to.equal(1)
			expect(store.counters.capped).to.equal(0)
		end)

		it("drops an open-ended state at the safety cap and reports it", function()
			local capped = {}
			local store = ReplicationBodyStateTracker.new(nil, function(userId, entry)
				table.insert(capped, { userId = userId, key = entry.key })
			end)
			ReplicationBodyStateTracker.set(store, 3, "upper", "pose", 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.get(store, 3, "upper", 1000 + MAX_OPEN - 1)).to.be.ok()
			expect(ReplicationBodyStateTracker.get(store, 3, "upper", 1000 + MAX_OPEN)).to.equal(nil)
			expect(#capped).to.equal(1)
			expect(capped[1].userId).to.equal(3)
			expect(capped[1].key).to.equal("upper")
			expect(store.counters.capped).to.equal(1)
		end)
	end)

	describe("per-body cap (MAX_BODY_STATES)", function()
		it("defaults to 8 live states per body", function()
			expect(ReplicationBodyStateTracker.new().maxStates).to.equal(8)
		end)

		it("refuses a new key once the body holds maxStates live states", function()
			local store = ReplicationBodyStateTracker.new(2)
			ReplicationBodyStateTracker.set(store, 1, "a", 1, 1000, nil, 1000)
			ReplicationBodyStateTracker.set(store, 1, "b", 2, 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.set(store, 1, "c", 3, 1000, nil, 1000)).to.equal("full")
			expect(ReplicationBodyStateTracker.get(store, 1, "c", 1000)).to.equal(nil)
			expect(store.counters.refused).to.equal(1)
		end)

		it("still replaces an existing key when the body is full", function()
			local store = ReplicationBodyStateTracker.new(2)
			ReplicationBodyStateTracker.set(store, 1, "a", 1, 1000, nil, 1000)
			ReplicationBodyStateTracker.set(store, 1, "b", 2, 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.set(store, 1, "a", 9, 1100, nil, 1100)).to.equal("replaced")
		end)

		it("counts only live states toward the cap", function()
			local store = ReplicationBodyStateTracker.new(2)
			ReplicationBodyStateTracker.set(store, 1, "a", 1, 1000, 100, 1000)
			ReplicationBodyStateTracker.set(store, 1, "b", 2, 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.set(store, 1, "c", 3, 1200, nil, 1200)).to.equal("created")
		end)
	end)

	describe("active (the replay list)", function()
		it("lists every live state oldest first, ties by key, with its original start time", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 2000, 5000, 2000)
			ReplicationBodyStateTracker.set(store, 1, "upper", "pose", 1000, nil, 2000)
			ReplicationBodyStateTracker.set(store, 1, "overlay", "wave", 1000, 5000, 2000)
			local list = ReplicationBodyStateTracker.active(store, 1, 2100)
			expect(#list).to.equal(3)
			expect(list[1].key).to.equal("overlay")
			expect(list[2].key).to.equal("upper")
			expect(list[3].key).to.equal("full")
			expect(list[3].startMs).to.equal(2000)
		end)

		it("leaves out states that have ended", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			ReplicationBodyStateTracker.set(store, 1, "upper", "pose", 1000, nil, 1000)
			local list = ReplicationBodyStateTracker.active(store, 1, 2000)
			expect(#list).to.equal(1)
			expect(list[1].key).to.equal("upper")
		end)

		it("is empty for a body with no states", function()
			expect(#ReplicationBodyStateTracker.active(ReplicationBodyStateTracker.new(), 9, 1000)).to.equal(0)
		end)
	end)

	describe("clearBody (death, respawn, slot switch, leave)", function()
		it("drops every state on the body and nothing else", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			ReplicationBodyStateTracker.set(store, 1, "upper", "pose", 1000, nil, 1000)
			ReplicationBodyStateTracker.set(store, 2, "full", "guard", 1000, 500, 1000)
			expect(ReplicationBodyStateTracker.clearBody(store, 1)).to.equal(2)
			expect(#ReplicationBodyStateTracker.active(store, 1, 1100)).to.equal(0)
			expect(ReplicationBodyStateTracker.get(store, 2, "full", 1100).data).to.equal("guard")
			expect(store.counters.cleared).to.equal(2)
		end)
	end)

	describe("size", function()
		it("counts the states held across bodies", function()
			local store = ReplicationBodyStateTracker.new()
			ReplicationBodyStateTracker.set(store, 1, "full", "leap", 1000, 500, 1000)
			ReplicationBodyStateTracker.set(store, 2, "upper", "pose", 1000, nil, 1000)
			expect(ReplicationBodyStateTracker.size(store)).to.equal(2)
		end)
	end)
end
