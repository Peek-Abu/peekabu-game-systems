local NpcConcealTracker = require(script.Parent.NpcConcealTracker)

return function()
	it("conceals a player from every NPC when none witnessed it", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", {})
		expect(tracker:isConcealed(7)).to.equal(true)
		expect(tracker:isConcealedFrom(7, 1)).to.equal(true)
		expect(tracker:isConcealedFrom(7, 2)).to.equal(true)
		expect(tracker:isConcealed(8)).to.equal(false)
		expect(tracker:isConcealedFrom(8, 1)).to.equal(false)
	end)

	it("never conceals a player from an NPC that witnessed it", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", { 1 })
		expect(tracker:isConcealedFrom(7, 1)).to.equal(false)
		expect(tracker:isConcealedFrom(7, 2)).to.equal(true)
	end)

	it("stays concealed while any source holds the player", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", {})
		tracker:conceal(7, "hide", {})
		tracker:reveal(7, "plant")
		expect(tracker:isConcealedFrom(7, 1)).to.equal(true)
		tracker:reveal(7, "hide")
		expect(tracker:isConcealed(7)).to.equal(false)
		expect(tracker:isConcealedFrom(7, 1)).to.equal(false)
	end)

	it("hides from an NPC through a source it did not witness", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", { 1 })
		tracker:conceal(7, "hide", {})
		expect(tracker:isConcealedFrom(7, 1)).to.equal(true)
	end)

	it("replaces a source's witnesses when it is concealed again", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", { 1 })
		tracker:conceal(7, "plant", {})
		expect(tracker:isConcealedFrom(7, 1)).to.equal(true)
	end)

	it("forgets a removed NPC's witness", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", { 1 })
		tracker:forgetNpc(1)
		expect(tracker:isConcealedFrom(7, 1)).to.equal(true)
	end)

	it("clears a player", function()
		local tracker = NpcConcealTracker.new()
		tracker:conceal(7, "plant", {})
		tracker:conceal(7, "hide", { 2 })
		tracker:clear(7)
		expect(tracker:isConcealed(7)).to.equal(false)
	end)

	it("ignores revealing a source that never concealed", function()
		local tracker = NpcConcealTracker.new()
		tracker:reveal(7, "plant")
		expect(tracker:isConcealed(7)).to.equal(false)
	end)
end
