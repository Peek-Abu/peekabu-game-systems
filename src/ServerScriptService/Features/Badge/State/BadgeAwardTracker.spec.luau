local BadgeAwardTracker = require(script.Parent.BadgeAwardTracker)

return function()
	it("starts unknown, then records ownership", function()
		local tracker = BadgeAwardTracker.new()
		expect(tracker:owned(1, "a")).to.equal(nil)
		tracker:setOwned(1, "a", false)
		expect(tracker:owned(1, "a")).to.equal(false)
		tracker:setOwned(1, "a", true)
		expect(tracker:owned(1, "a")).to.equal(true)
		expect(tracker:owned(2, "a")).to.equal(nil)
	end)

	it("lets only one award per player and key be in flight", function()
		local tracker = BadgeAwardTracker.new()
		expect(tracker:begin(1, "a")).to.equal(true)
		expect(tracker:begin(1, "a")).to.equal(false)
		expect(tracker:begin(1, "b")).to.equal(true)
		tracker:finish(1, "a")
		expect(tracker:begin(1, "a")).to.equal(true)
	end)

	it("forgets a player", function()
		local tracker = BadgeAwardTracker.new()
		tracker:setOwned(1, "a", true)
		tracker:begin(1, "b")
		tracker:forget(1)
		expect(tracker:owned(1, "a")).to.equal(nil)
		expect(tracker:begin(1, "b")).to.equal(true)
	end)
end
