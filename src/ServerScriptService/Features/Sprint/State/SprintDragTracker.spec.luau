local SprintDragTracker = require(script.Parent.SprintDragTracker)

return function()
	it("has no drag until one is set", function()
		local tracker = SprintDragTracker.new()
		local humanoid = Instance.new("Humanoid")
		expect(tracker:scaleOf(1, humanoid)).to.equal(1)
	end)

	it("reports the change a new drag makes to the live speed, and holds it", function()
		local tracker = SprintDragTracker.new()
		local humanoid = Instance.new("Humanoid")
		local from, to = tracker:set(1, humanoid, 0.75)
		expect(from).to.equal(1)
		expect(to).to.equal(0.75)
		expect(tracker:scaleOf(1, humanoid)).to.equal(0.75)
		from, to = tracker:set(1, humanoid, 1)
		expect(from).to.equal(0.75)
		expect(to).to.equal(1)
		expect(tracker:scaleOf(1, humanoid)).to.equal(1)
	end)

	it("reports nothing when the drag is unchanged", function()
		local tracker = SprintDragTracker.new()
		local humanoid = Instance.new("Humanoid")
		tracker:set(1, humanoid, 0.75)
		local from = tracker:set(1, humanoid, 0.75)
		expect(from).to.equal(nil)
	end)

	it("never carries a drag onto a new body (its speed starts plain)", function()
		local tracker = SprintDragTracker.new()
		local old = Instance.new("Humanoid")
		local new = Instance.new("Humanoid")
		tracker:set(1, old, 0.75)
		expect(tracker:scaleOf(1, new)).to.equal(1)
		local from, to = tracker:set(1, new, 0.75)
		expect(from).to.equal(1)
		expect(to).to.equal(0.75)
		expect(tracker:scaleOf(1, nil)).to.equal(1)
	end)

	it("refuses a non-positive drag, and forgets a player", function()
		local tracker = SprintDragTracker.new()
		local humanoid = Instance.new("Humanoid")
		expect(tracker:set(1, humanoid, 0)).to.equal(nil)
		expect(tracker:scaleOf(1, humanoid)).to.equal(1)
		tracker:set(1, humanoid, 0.5)
		tracker:clear(1)
		expect(tracker:scaleOf(1, humanoid)).to.equal(1)
	end)
end
