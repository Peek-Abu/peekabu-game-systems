local SprintBoostTracker = require(script.Parent.SprintBoostTracker)

return function()
	it("holds a boost's scale until it is expired", function()
		local tracker = SprintBoostTracker.new()
		expect(tracker:scaleOf(1)).to.equal(1)
		expect(tracker:boost(1, 1.25, 10)).to.equal(1.25)
		expect(tracker:scaleOf(1)).to.equal(1.25)
		-- Past its time but not yet expired, the scale still holds (WalkSpeed still carries it until the rescale).
		expect(tracker:scaleOf(1)).to.equal(1.25)
		local ended = tracker:expired(11)
		expect(#ended).to.equal(1)
		expect(ended[1].userId).to.equal(1)
		expect(ended[1].scale).to.equal(1.25)
		expect(tracker:scaleOf(1)).to.equal(1)
		expect(#tracker:expired(12)).to.equal(0)
	end)

	it("never stacks a boost given again: the bigger scale, the later end", function()
		local tracker = SprintBoostTracker.new()
		tracker:boost(1, 1.25, 10)
		expect(tracker:boost(1, 1.25, 12)).to.equal(1.25)
		expect(#tracker:expired(11)).to.equal(0)
		expect(tracker:boost(1, 1.1, 14)).to.equal(1.25)
		expect(#tracker:expired(13)).to.equal(0)
		expect(#tracker:expired(14)).to.equal(1)
	end)

	it("keeps players apart and clears one", function()
		local tracker = SprintBoostTracker.new()
		tracker:boost(1, 1.25, 10)
		tracker:boost(2, 1.25, 10)
		tracker:clear(1)
		expect(tracker:scaleOf(1)).to.equal(1)
		expect(tracker:scaleOf(2)).to.equal(1.25)
	end)

	it("ignores a scale that is not a speed-up", function()
		local tracker = SprintBoostTracker.new()
		expect(tracker:boost(1, 0, 10)).to.equal(1)
		expect(tracker:boost(1, -3, 10)).to.equal(1)
		expect(tracker:scaleOf(1)).to.equal(1)
	end)
end
