local Rules = require(script.Parent.OccupantReachRules)
return function()
	describe("body grab reach", function()
		it("reaches a normal jumping character close horizontally", function()
			expect(Rules.canReach(Vector3.new(0, 4.9, 0), Vector3.new(2, 10.8, 0), 7.8, 7.4, 3)).to.equal(true)
		end)
		it("rejects separated floors and high ledges", function()
			expect(Rules.canReach(Vector3.new(0, 4.9, 0), Vector3.new(2, 16, 0), 13, 7.4, 3)).to.equal(false)
			expect(Rules.canReach(Vector3.new(0, 4.9, 0), Vector3.new(2, 12, 0), 10, 7.4, 3)).to.equal(false)
		end)
		it("does not extend horizontal reach for airborne victims", function()
			expect(Rules.canReach(Vector3.new(0, 4.9, 0), Vector3.new(4, 10, 0), 7, 7.4, 3)).to.equal(false)
		end)
	end)
end
