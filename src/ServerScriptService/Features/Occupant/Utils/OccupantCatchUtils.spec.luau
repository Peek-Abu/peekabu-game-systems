local OccupantCatchUtils = require(script.Parent.OccupantCatchUtils)

return function()
	describe("afterCatch", function()
		it("kills a knocked-out player and keeps them down: no back-at time, the out toast, no rehire", function()
			local after = OccupantCatchUtils.afterCatch(true)
			expect(after.kill).to.equal(true)
			expect(after.publishBack).to.equal(nil)
			expect(after.toast).to.equal("out")
			expect(after.rehire).to.equal(false)
		end)

		it("knocks down a player with a life left: no kill, no back-at time, the hit toast, no rehire", function()
			local after = OccupantCatchUtils.afterCatch(false)
			expect(after.kill).to.equal(false)
			expect(after.publishBack).to.equal(nil)
			expect(after.toast).to.equal("hit")
			expect(after.rehire).to.equal(false)
		end)
	end)

	describe("feedback", function()
		it("tells the crew and shows the first-catch tip on a shift", function()
			local feedback = OccupantCatchUtils.feedback(false)
			expect(feedback.crewToast).to.equal(true)
			expect(feedback.tip).to.equal(true)
		end)

		it("leaves a training catch to training's one line", function()
			local feedback = OccupantCatchUtils.feedback(true)
			expect(feedback.crewToast).to.equal(false)
			expect(feedback.tip).to.equal(false)
		end)
	end)
end
