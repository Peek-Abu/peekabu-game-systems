local AbilityCooldownTracker = require(script.Parent.AbilityCooldownTracker)

return function()
	it("is ready until used, then ready again a cooldown later", function()
		local tracker = AbilityCooldownTracker.new()
		expect(tracker:readyAt(1)).to.equal(0)
		expect(tracker:spend(1, 100, 45)).to.equal(145)
		expect(tracker:readyAt(1)).to.equal(145)
		expect(tracker:readyAt(2)).to.equal(0)
	end)

	it("makes everyone ready again for a new shift, and lists who was waiting", function()
		local tracker = AbilityCooldownTracker.new()
		tracker:spend(1, 100, 45)
		tracker:spend(2, 100, 40)
		local reset = tracker:resetAll()
		table.sort(reset)
		expect(#reset).to.equal(2)
		expect(reset[1]).to.equal(1)
		expect(tracker:readyAt(1)).to.equal(0)
		expect(tracker:readyAt(2)).to.equal(0)
	end)

	it("keeps one running plant per player", function()
		local tracker = AbilityCooldownTracker.new()
		expect(tracker:plantOf(1)).to.equal(nil)
		tracker:startPlant(1, { startedAt = 10, origin = Vector3.new(1, 2, 3), cancelled = false })
		expect(tracker:plantOf(1).startedAt).to.equal(10)
		expect(#tracker:planters()).to.equal(1)
		tracker:endPlant(1)
		expect(tracker:plantOf(1)).to.equal(nil)
		expect(#tracker:planters()).to.equal(0)
	end)

	it("forgets a player who leaves", function()
		local tracker = AbilityCooldownTracker.new()
		tracker:spend(1, 100, 45)
		tracker:startPlant(1, { startedAt = 10, origin = Vector3.zero, cancelled = false })
		tracker:clear(1)
		expect(tracker:readyAt(1)).to.equal(0)
		expect(tracker:plantOf(1)).to.equal(nil)
	end)

	it("spends nothing for a player in no-cooldown mode, until it is turned off", function()
		local tracker = AbilityCooldownTracker.new()
		tracker:setFree(1, true)
		expect(tracker:isFree(1)).to.equal(true)
		expect(tracker:spend(1, 100, 45)).to.equal(0)
		expect(tracker:readyAt(1)).to.equal(0)
		expect(tracker:isFree(2)).to.equal(false)
		tracker:setFree(1, false)
		expect(tracker:spend(1, 100, 45)).to.equal(145)
	end)

	it("resets one player's cooldown, keeps no-cooldown mode across a new shift, and drops it on leaving", function()
		local tracker = AbilityCooldownTracker.new()
		tracker:spend(1, 100, 45)
		tracker:spend(2, 100, 45)
		expect(tracker:reset(1)).to.equal(true)
		expect(tracker:readyAt(1)).to.equal(0)
		expect(tracker:readyAt(2)).to.equal(145)
		expect(tracker:reset(1)).to.equal(false)
		tracker:setFree(3, true)
		tracker:resetAll()
		expect(tracker:isFree(3)).to.equal(true)
		tracker:clear(3)
		expect(tracker:isFree(3)).to.equal(false)
	end)
end
