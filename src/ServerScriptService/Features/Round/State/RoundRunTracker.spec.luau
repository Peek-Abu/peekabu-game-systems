local RoundRunTracker = require(script.Parent.RoundRunTracker)

local RUNNING = { phase = "running", round = 2, endsAt = 90 }

return function()
	describe("participants", function()
		it("starts a run with the given participants, sorted in the snapshot", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 3, 1, 2 })
			expect(tracker:isParticipant(1)).to.equal(true)
			expect(tracker:isParticipant(9)).to.equal(false)
			local snapshot = tracker:snapshot(RUNNING)
			expect(snapshot.participants[1]).to.equal(1)
			expect(snapshot.participants[3]).to.equal(3)
			expect(snapshot.phase).to.equal("running")
			expect(snapshot.round).to.equal(2)
			expect(snapshot.endsAt).to.equal(90)
		end)

		it("counts participants and the ones still alive", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 1, 2, 3 })
			expect(tracker:eliminate(2)).to.equal(true)
			expect(tracker:eliminate(2)).to.equal(false)
			expect(tracker:eliminate(9)).to.equal(false)
			local counts = tracker:counts(5)
			expect(counts.present).to.equal(5)
			expect(counts.participants).to.equal(3)
			expect(counts.alive).to.equal(2)
			expect(tracker:snapshot(RUNNING).eliminated[1]).to.equal(2)
		end)

		it("revives an eliminated participant", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 1 })
			tracker:eliminate(1)
			expect(tracker:revive(1)).to.equal(true)
			expect(tracker:counts(1).alive).to.equal(1)
			expect(tracker:revive(1)).to.equal(false)
		end)

		it("drops a participant who leaves, eliminated or not", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 1, 2 })
			tracker:eliminate(2)
			tracker:removeParticipant(2)
			tracker:removeParticipant(1)
			local counts = tracker:counts(0)
			expect(counts.participants).to.equal(0)
			expect(#tracker:snapshot(RUNNING).eliminated).to.equal(0)
		end)

		it("adds a late joiner once", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 1 })
			expect(tracker:addParticipant(2)).to.equal(true)
			expect(tracker:addParticipant(2)).to.equal(false)
			expect(tracker:counts(2).participants).to.equal(2)
		end)
	end)

	describe("team counters and targets", function()
		it("adds, spends and reports a shared counter", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({})
			expect(tracker:addTeam("scrap", 40)).to.equal(40)
			expect(tracker:addTeam("scrap", 5)).to.equal(45)
			expect(tracker:spendTeam("scrap", 50)).to.equal(false)
			expect(tracker:spendTeam("scrap", 45)).to.equal(true)
			expect(tracker:teamValue("scrap")).to.equal(0)
			expect(tracker:teamValue("unused")).to.equal(0)
		end)

		it("refuses a non-finite amount", function()
			local tracker = RoundRunTracker.new()
			expect(function()
				tracker:addTeam("scrap", 0 / 0)
			end).to.throw()
			expect(function()
				tracker:addTeam("scrap", math.huge)
			end).to.throw()
		end)

		it("reports whether a target is met", function()
			local tracker = RoundRunTracker.new()
			tracker:setTarget("scrap", 100)
			expect(tracker:targetMet("scrap")).to.equal(false)
			tracker:addTeam("scrap", 100)
			expect(tracker:targetMet("scrap")).to.equal(true)
			expect(tracker:targetMet("no-target")).to.equal(false)
			expect(tracker:snapshot(RUNNING).targets.scrap).to.equal(100)
		end)
	end)

	describe("scores", function()
		it("keeps per-player counters keyed by the userId as a string in the snapshot", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 7 })
			expect(tracker:addScore(7, "kills", 2)).to.equal(2)
			expect(tracker:addScore(7, "kills", 1)).to.equal(3)
			expect(tracker:scoreOf(7, "kills")).to.equal(3)
			expect(tracker:scoreOf(8, "kills")).to.equal(0)
			expect(tracker:snapshot(RUNNING).scores["7"].kills).to.equal(3)
		end)

		it("keeps a leaver's score for the results", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 7 })
			tracker:addScore(7, "kills", 1)
			tracker:removeParticipant(7)
			expect(tracker:scoreOf(7, "kills")).to.equal(1)
		end)
	end)

	describe("containers", function()
		it("creates a container on first use and mints run-local uids", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({}, 4)
			local items = tracker:container("team")
			expect(#items).to.equal(0)
			expect(tracker:container("team")).to.equal(items)
			expect(tracker:nextUid()).to.equal("r4-1")
			expect(tracker:nextUid()).to.equal("r4-2")
		end)

		it("snapshots containers as copies", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({})
			table.insert(tracker:container("team"), { itemType = "scrap", quantity = 3 })
			local snapshot = tracker:snapshot(RUNNING)
			expect(snapshot.containers.team[1].quantity).to.equal(3)
			snapshot.containers.team[1].quantity = 99
			expect(tracker:container("team")[1].quantity).to.equal(3)
		end)
	end)

	describe("reset", function()
		it("clears everything from the previous run", function()
			local tracker = RoundRunTracker.new()
			tracker:reset({ 1 })
			tracker:addTeam("scrap", 10)
			tracker:setTarget("scrap", 20)
			tracker:addScore(1, "kills", 1)
			table.insert(tracker:container("team"), { itemType = "scrap", quantity = 1 })
			tracker:reset({ 2 })
			local snapshot = tracker:snapshot(RUNNING)
			expect(tracker:isParticipant(1)).to.equal(false)
			expect(snapshot.team.scrap).to.equal(nil)
			expect(snapshot.targets.scrap).to.equal(nil)
			expect(snapshot.scores["1"]).to.equal(nil)
			expect(snapshot.containers.team).to.equal(nil)
		end)
	end)
end
