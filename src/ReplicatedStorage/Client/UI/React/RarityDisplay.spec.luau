--!nocheck
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RarityDisplay = require(ReplicatedStorage.Client.UI.React.RarityDisplay)

return function()
	describe("rank", function()
		it("orders the flavour tiers low to high", function()
			expect(RarityDisplay.rank("common")).to.equal(1)
			expect(RarityDisplay.rank("legendary")).to.equal(5)
			expect(RarityDisplay.rank("cursed")).to.equal(6)
		end)
		it("ranks an unknown rarity to the bottom (0)", function()
			expect(RarityDisplay.rank("nonsense")).to.equal(0)
		end)
	end)

	describe("borderColor", function()
		it("returns the saturated slot-border tint for a known rarity", function()
			expect(RarityDisplay.borderColor("legendary")).to.equal(Color3.fromRGB(190, 141, 28))
			expect(RarityDisplay.borderColor("cursed")).to.equal(Color3.fromRGB(173, 4, 35))
		end)
		it("returns the pale-blue empty border when there is no item", function()
			expect(RarityDisplay.borderColor(nil)).to.equal(Color3.fromRGB(185, 231, 255))
		end)
		it("falls back to common for an unknown rarity (never black)", function()
			expect(RarityDisplay.borderColor("nonsense")).to.equal(RarityDisplay.borderColor("common"))
		end)
	end)

	describe("accentColor", function()
		it("returns the pastel detail-panel accent for a known rarity", function()
			expect(RarityDisplay.accentColor("legendary")).to.equal(Color3.fromRGB(255, 136, 0))
		end)
		it("falls back to common for an unknown rarity", function()
			expect(RarityDisplay.accentColor("nonsense")).to.equal(RarityDisplay.accentColor("common"))
		end)
	end)

	describe("the two palettes", function()
		it("are genuinely distinct — the border tint is not the detail accent", function()
			expect(RarityDisplay.borderColor("rare")).never.to.equal(RarityDisplay.accentColor("rare"))
			expect(RarityDisplay.borderColor("epic")).never.to.equal(RarityDisplay.accentColor("epic"))
		end)
	end)
end
