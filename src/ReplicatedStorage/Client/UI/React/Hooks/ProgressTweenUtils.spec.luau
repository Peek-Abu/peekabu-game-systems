local Utils = require(script.Parent.ProgressTweenUtils)
return function()
	describe("progress tween policy", function()
		it("rejects nonfinite fractions and bounds overshoot", function()
			expect(Utils.target(0 / 0)).to.equal(0)
			expect(Utils.target(math.huge)).to.equal(0)
			expect(Utils.target(-1)).to.equal(0)
			expect(Utils.target(2)).to.equal(1)
		end)
		it("resets cancelled holds and changed targets immediately", function()
			expect(Utils.snap(0.8, 0, false, false, true)).to.equal(true)
			expect(Utils.snap(0.8, 0.1, false, true, false)).to.equal(true)
		end)
		it("animates gains but never animates reduced motion", function()
			expect(Utils.snap(0.2, 0.7, false, false, true)).to.equal(false)
			expect(Utils.snap(0.2, 0.7, true, false, false)).to.equal(true)
			expect(Utils.snap(0.7, 0.7, false, false, false)).to.equal(true)
		end)
	end)
end
