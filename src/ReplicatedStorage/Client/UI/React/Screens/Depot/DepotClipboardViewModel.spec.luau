local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VM = require(script.Parent.DepotClipboardViewModel)
local Rules = require(ReplicatedStorage.Shared.Features.Timecard.Rules.TimecardRules)
local Constants = require(ReplicatedStorage.Shared.Features.Timecard.Data.TimecardConstants)

local MONDAY = 1792972800

return function()
	describe("DepotClipboardViewModel", function()
		describe("slots", function()
			it("draws one slot per punch the card needs, done ones first, then today's", function()
				local status = Rules.status({ week = MONDAY, punched = { 1, 2 }, weeks = 0 }, MONDAY + 2 * 86400)
				local slots = VM.slots(status)
				expect(#slots).to.equal(Constants.PUNCHES_TO_FILL)
				expect(slots[1].state).to.equal("done")
				expect(slots[2].state).to.equal("done")
				expect(slots[3].state).to.equal("today")
				expect(slots[4].state).to.equal("empty")
				expect(slots[5].number).to.equal(5)
			end)

			it("has no today slot once today is punched", function()
				local status = Rules.status({ week = MONDAY, punched = { 1 }, weeks = 0 }, MONDAY)
				local slots = VM.slots(status)
				expect(slots[1].state).to.equal("done")
				expect(slots[2].state).to.equal("empty")
			end)

			it("hangs the Gloom Key on the key punch and the Gleam on the last", function()
				local slots = VM.slots(Rules.status({ week = MONDAY, punched = {}, weeks = 0 }, MONDAY))
				expect(slots[Constants.KEY_PUNCH].prize).to.equal("key")
				expect(slots[Constants.PUNCHES_TO_FILL].prize).to.equal("gleam")
				expect(slots[1].prize).to.equal(nil)
			end)

			it("is all done on a full card", function()
				local status =
					Rules.status({ week = MONDAY, punched = { 1, 2, 3, 4, 5 }, weeks = 0 }, MONDAY + 5 * 86400)
				for _, slot in VM.slots(status) do
					expect(slot.state).to.equal("done")
				end
			end)
		end)

		describe("slotCenter", function()
			it("puts every slot on one track inside the sheet", function()
				local first = VM.slotCenter(1)
				local last = VM.slotCenter(Constants.PUNCHES_TO_FILL)
				expect(first.Y).to.equal(last.Y)
				expect(VM.slotCenter(2).X - first.X).to.equal(VM.SLOT_STEP)
				expect(first.X - VM.SLOT / 2 >= 0).to.equal(true)
				expect(last.X + VM.SLOT / 2 <= VM.SHEET.X).to.equal(true)
				expect(VM.SHEET_AT.X + VM.SHEET.X <= VM.BOARD.X).to.equal(true)
				expect(VM.SHEET_AT.Y + VM.SHEET.Y <= VM.BOARD.Y).to.equal(true)
			end)
		end)

		describe("done", function()
			it("says how many punches are in, in plain words", function()
				local status = Rules.status({ week = MONDAY, punched = { 1, 2 }, weeks = 0 }, MONDAY + 2 * 86400)
				expect(VM.done(status)).to.equal("2 of 5 done")
				local full = Rules.status({ week = MONDAY, punched = { 1, 2, 3, 4, 5 }, weeks = 0 }, MONDAY + 5 * 86400)
				expect(VM.done(full)).to.equal("Card full!")
			end)
		end)

		describe("paycheck", function()
			it("fills one dot per full week toward the paycheck", function()
				local status = Rules.status({ week = MONDAY, punched = {}, weeks = 1 }, MONDAY)
				local paycheck = VM.paycheck(status)
				expect(paycheck.total).to.equal(Constants.PAYCHEQUE_WEEKS)
				expect(paycheck.filled).to.equal(Constants.PAYCHEQUE_WEEKS - status.weeksToPaycheque)
				expect(paycheck.credits).to.equal(Constants.PAYCHEQUE_CREDITS)
			end)
		end)

		describe("newJob", function()
			it("counts down to the next UTC day in hours and minutes", function()
				expect(VM.newJob(86400 - 3600 * 5 - 60 * 12)).to.equal("NEW JOB IN 5H 12M")
				expect(VM.newJob(86400 - 60 * 7)).to.equal("NEW JOB IN 7M")
				expect(VM.newJob(86400 - 1)).to.equal("NEW JOB IN 1M")
				expect(VM.newJob(86400)).to.equal("NEW JOB IN 24H 0M")
			end)
		end)
	end)
end
