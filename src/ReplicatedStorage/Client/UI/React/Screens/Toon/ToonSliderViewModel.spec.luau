local ToonSliderViewModel = require(script.Parent.ToonSliderViewModel)

return function()
	describe("fraction", function()
		it("places a value along the track", function()
			expect(ToonSliderViewModel.fraction(0.25, 0, 1)).to.equal(0.25)
			expect(ToonSliderViewModel.fraction(50, 0, 200)).to.equal(0.25)
		end)

		it("stays on the track for out-of-range values and an empty range", function()
			expect(ToonSliderViewModel.fraction(-1, 0, 1)).to.equal(0)
			expect(ToonSliderViewModel.fraction(3, 0, 1)).to.equal(1)
			expect(ToonSliderViewModel.fraction(5, 5, 5)).to.equal(0)
		end)
	end)

	describe("snap", function()
		it("rounds to the nearest step from the minimum", function()
			expect(ToonSliderViewModel.snap(0.52, 0, 1, 0.05)).to.equal(0.5)
			expect(ToonSliderViewModel.snap(0.53, 0, 1, 0.05)).to.equal(0.55)
			expect(ToonSliderViewModel.snap(7, 1, 11, 2)).to.equal(7)
			expect(ToonSliderViewModel.snap(7.9, 1, 11, 2)).to.equal(7)
		end)

		it("gives clean values (no float noise to send to the server)", function()
			expect(ToonSliderViewModel.snap(0.3, 0, 1, 0.05)).to.equal(0.3)
			expect(ToonSliderViewModel.snap(0.7000001, 0, 1, 0.05)).to.equal(0.7)
		end)

		it("clamps to the range", function()
			expect(ToonSliderViewModel.snap(-0.2, 0, 1, 0.05)).to.equal(0)
			expect(ToonSliderViewModel.snap(1.4, 0, 1, 0.05)).to.equal(1)
		end)

		it("keeps a continuous value when there is no step", function()
			expect(ToonSliderViewModel.snap(0.123, 0, 1, nil)).to.equal(0.123)
		end)
	end)

	describe("fromPointer", function()
		it("maps a pointer x across the track to a stepped value", function()
			-- A 200 px track at x 100: x 150 is a quarter along.
			expect(ToonSliderViewModel.fromPointer(150, 100, 200, 0, 1, 0.05)).to.equal(0.25)
			expect(ToonSliderViewModel.fromPointer(301, 100, 200, 0, 1, 0.05)).to.equal(1)
		end)

		it("clamps a drag past either end", function()
			expect(ToonSliderViewModel.fromPointer(-50, 100, 200, 0, 1, 0.05)).to.equal(0)
			expect(ToonSliderViewModel.fromPointer(900, 100, 200, 0, 1, 0.05)).to.equal(1)
		end)

		it("reads the minimum on a track with no width yet", function()
			expect(ToonSliderViewModel.fromPointer(10, 0, 0, 0, 1, 0.05)).to.equal(0)
		end)
	end)

	describe("nudge", function()
		it("moves one step per key or d-pad press", function()
			expect(ToonSliderViewModel.nudge(0.5, 1, 0, 1, 0.05)).to.equal(0.55)
			expect(ToonSliderViewModel.nudge(0.5, -1, 0, 1, 0.05)).to.equal(0.45)
		end)

		it("stops at the ends", function()
			expect(ToonSliderViewModel.nudge(1, 1, 0, 1, 0.05)).to.equal(1)
			expect(ToonSliderViewModel.nudge(0, -1, 0, 1, 0.05)).to.equal(0)
		end)

		it("moves a twentieth of the range when there is no step", function()
			expect(ToonSliderViewModel.nudge(0.5, 1, 0, 1, nil)).to.equal(0.55)
		end)
	end)

	describe("percent", function()
		it("reads the value as a whole percentage of the range", function()
			expect(ToonSliderViewModel.percent(0.75, 0, 1)).to.equal("75%")
			expect(ToonSliderViewModel.percent(0, 0, 1)).to.equal("0%")
			expect(ToonSliderViewModel.percent(1, 0, 1)).to.equal("100%")
			expect(ToonSliderViewModel.percent(0.333, 0, 1)).to.equal("33%")
		end)
	end)

	describe("direction", function()
		it("reads arrow keys, A / D and the d-pad as a step left or right", function()
			expect(ToonSliderViewModel.direction(Enum.KeyCode.Left)).to.equal(-1)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.A)).to.equal(-1)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.DPadLeft)).to.equal(-1)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.Right)).to.equal(1)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.D)).to.equal(1)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.DPadRight)).to.equal(1)
		end)

		it("ignores every other key", function()
			expect(ToonSliderViewModel.direction(Enum.KeyCode.Space)).to.equal(0)
			expect(ToonSliderViewModel.direction(Enum.KeyCode.DPadUp)).to.equal(0)
		end)
	end)
end
