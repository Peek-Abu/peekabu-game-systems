local VM = require(script.Parent.PaperButtonViewModel)
return function()
	describe("button motion", function()
		it("grows and tilts for hover and focus with an identical target", function()
			local hover = VM.pose(true, false, false, false, false)
			local focus = VM.pose(false, false, true, false, false)
			expect(hover.scale > 1).to.equal(true)
			expect(hover.tilt ~= 0).to.equal(true)
			expect(focus.scale).to.equal(hover.scale)
			expect(focus.tilt).to.equal(hover.tilt)
		end)
		it("press takes priority and compresses the face", function()
			local pose = VM.pose(true, true, true, false, false)
			expect(pose.scale < 1).to.equal(true)
			expect(pose.tilt > 0).to.equal(true)
		end)
		it("disabled and reduced motion remain at rest", function()
			for _, pose in { VM.pose(true, true, true, true, false), VM.pose(true, true, true, false, true) } do
				expect(pose.scale).to.equal(1)
				expect(pose.tilt).to.equal(0)
			end
		end)
	end)
	describe("button feedback", function()
		it("keeps idle ink unchanged", function()
			expect(VM.ink(false, false, false, false)).to.equal(0)
		end)
		it("makes press stronger than hover or keyboard focus", function()
			expect(VM.ink(false, true, false, false) > VM.ink(true, false, false, false)).to.equal(true)
			expect(VM.ink(false, false, true, false) > 0).to.equal(true)
		end)
		it("keeps disabled buttons quiet for every interaction", function()
			expect(VM.ink(true, true, true, true)).to.equal(0)
		end)
	end)
end
