local SoundVoiceTracker = require(script.Parent.SoundVoiceTracker)

return function()
	it("starts voices without eviction under the cap", function()
		local tracker = SoundVoiceTracker.new()
		local _, evicted = tracker:start("step", 2)
		expect(evicted).to.equal(nil)
		local _, evicted2 = tracker:start("step", 2)
		expect(evicted2).to.equal(nil)
		expect(tracker:count("step")).to.equal(2)
	end)

	it("evicts the oldest voice when the cap is reached", function()
		local tracker = SoundVoiceTracker.new()
		local first = tracker:start("step", 2)
		tracker:start("step", 2)
		local _, evicted = tracker:start("step", 2)
		expect(evicted).to.equal(first)
		expect(tracker:count("step")).to.equal(2)
	end)

	it("never evicts with no cap", function()
		local tracker = SoundVoiceTracker.new()
		for _ = 1, 10 do
			local _, evicted = tracker:start("rain", nil)
			expect(evicted).to.equal(nil)
		end
		expect(tracker:count("rain")).to.equal(10)
	end)

	it("keeps ids apart", function()
		local tracker = SoundVoiceTracker.new()
		tracker:start("a", 1)
		local _, evicted = tracker:start("b", 1)
		expect(evicted).to.equal(nil)
	end)

	it("finish frees a voice so the next start does not evict", function()
		local tracker = SoundVoiceTracker.new()
		local first = tracker:start("step", 1)
		tracker:finish(first)
		local _, evicted = tracker:start("step", 1)
		expect(evicted).to.equal(nil)
	end)

	it("finish is safe for an unknown or already-finished token", function()
		local tracker = SoundVoiceTracker.new()
		local token = tracker:start("step", 1)
		tracker:finish(token)
		tracker:finish(token)
		tracker:finish(999)
		expect(tracker:count("step")).to.equal(0)
	end)
end
