local ShopStore = require(script.Parent.ShopStore)

return function()
	afterEach(function()
		ShopStore.reset()
	end)

	it("opens a product page and closes it", function()
		ShopStore.open("Pippa.BubbleBuddy")
		expect(ShopStore.product()).to.equal("Pippa.BubbleBuddy")
		ShopStore.close()
		expect(ShopStore.product()).to.equal(nil)
	end)

	it("keeps each pass's fetched price and icon, and forgets them on reset", function()
		ShopStore.setPassInfo("bigCrew", { price = 149, icon = "rbxassetid://5", name = "Big Crew", forSale = true })
		expect(ShopStore.passInfo().bigCrew.price).to.equal(149)
		ShopStore.reset()
		expect(ShopStore.passInfo().bigCrew).to.equal(nil)
	end)

	it("keeps each Gleam bundle's fetched price and icon, and forgets them on reset", function()
		ShopStore.setBundleInfo("gleam100", { price = 99, icon = "rbxassetid://5" })
		expect(ShopStore.bundleInfo().gleam100.price).to.equal(99)
		expect(ShopStore.bundleInfo().gleam100.icon).to.equal("rbxassetid://5")
		ShopStore.reset()
		expect(ShopStore.bundleInfo().gleam100).to.equal(nil)
	end)

	it("keeps the last buy result, clearing it when another page opens", function()
		ShopStore.setResult({ offer = "Prickles", reason = "short" })
		expect(ShopStore.result().reason).to.equal("short")
		ShopStore.open("Cappy")
		expect(ShopStore.result()).to.equal(nil)
	end)
	describe("back to the item after buying Gleam", function()
		it("goes back to the item's page with the question up, once, and forgets it", function()
			ShopStore.open("Pippa.BubbleBuddy")
			ShopStore.close()
			ShopStore.setReturn({ offer = "Pippa.BubbleBuddy", tab = "skins", gleam = 1500, name = "Bubble Buddy" })
			expect(ShopStore.returnTo().gleam).to.equal(1500)
			ShopStore.goBack()
			expect(ShopStore.product()).to.equal("Pippa.BubbleBuddy")
			expect(ShopStore.tab()).to.equal("skins")
			expect(ShopStore.ask()).to.equal(true)
			expect(ShopStore.returnTo()).to.equal(nil)
			ShopStore.asked()
			expect(ShopStore.ask()).to.equal(false)
			-- Nothing to go back to: nothing changes.
			ShopStore.goBack()
			expect(ShopStore.product()).to.equal("Pippa.BubbleBuddy")
			expect(ShopStore.ask()).to.equal(false)
		end)

		it("goes back to a tab without asking anything", function()
			ShopStore.setReturn({ offer = nil, tab = "lockers", gleam = 101, name = "Lockers" })
			ShopStore.goBack()
			expect(ShopStore.product()).to.equal(nil)
			expect(ShopStore.tab()).to.equal("lockers")
			expect(ShopStore.ask()).to.equal(false)
		end)

		it("keeps the way back while the player browses the Gleam tab, and forgets it on a new visit", function()
			ShopStore.setReturn({ offer = "Cappy", tab = "hires", gleam = 30, name = "Cappy" })
			ShopStore.close()
			expect(ShopStore.returnTo()).never.to.equal(nil)
			ShopStore.open(nil)
			expect(ShopStore.returnTo()).to.equal(nil)
			ShopStore.setReturn({ offer = "Cappy", tab = "hires", gleam = 30, name = "Cappy" })
			ShopStore.openTab("lockers")
			expect(ShopStore.returnTo()).to.equal(nil)
		end)
	end)

	describe("openTab (the hub's Lost & Found lockers)", function()
		it("opens on a tab, and opening an item or the plain Shop forgets it", function()
			ShopStore.reset()
			expect(ShopStore.tab()).to.equal(nil)
			ShopStore.openTab("lockers")
			expect(ShopStore.tab()).to.equal("lockers")
			expect(ShopStore.product()).to.equal(nil)
			ShopStore.open(nil)
			expect(ShopStore.tab()).to.equal(nil)
			ShopStore.openTab("lockers")
			ShopStore.reset()
			expect(ShopStore.tab()).to.equal(nil)
		end)
	end)
end
