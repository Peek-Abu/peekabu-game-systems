local OfficeGlowRules = require(script.Parent.OfficeGlowRules)

return function()
	describe("cleaned", function()
		it("glows a room that had Gloom this shift and has none left", function()
			expect(OfficeGlowRules.cleaned(0, true)).to.equal(true)
		end)

		it("never glows a room that never had Gloom, or still has some", function()
			expect(OfficeGlowRules.cleaned(0, false)).to.equal(false)
			expect(OfficeGlowRules.cleaned(2, true)).to.equal(false)
		end)
	end)

	describe("judged", function()
		it("judges only rooms near the camera (far piles may not be streamed in)", function()
			expect(OfficeGlowRules.judged(OfficeGlowRules.JUDGE_RANGE - 1)).to.equal(true)
			expect(OfficeGlowRules.judged(OfficeGlowRules.JUDGE_RANGE + 1)).to.equal(false)
		end)
	end)

	describe("glow", function()
		it("fades in over the fade time and holds", function()
			expect(OfficeGlowRules.glow(0)).to.equal(0)
			local half = OfficeGlowRules.glow(OfficeGlowRules.FADE_SECONDS / 2)
			expect(half > 0 and half < OfficeGlowRules.GLOW_BRIGHTNESS).to.equal(true)
			expect(OfficeGlowRules.glow(OfficeGlowRules.FADE_SECONDS)).to.equal(OfficeGlowRules.GLOW_BRIGHTNESS)
			expect(OfficeGlowRules.glow(99)).to.equal(OfficeGlowRules.GLOW_BRIGHTNESS)
		end)

		it("reaches across a room up to the light's limit", function()
			expect(OfficeGlowRules.range(Vector3.new(10, 1, 10)) > 10).to.equal(true)
			expect(OfficeGlowRules.range(Vector3.new(400, 1, 400))).to.equal(OfficeGlowRules.MAX_RANGE)
		end)
	end)

	describe("lantern", function()
		it("always lights your own lantern", function()
			expect(OfficeGlowRules.lantern(true, 1, 0)).to.equal(OfficeGlowRules.LANTERN_BRIGHTNESS)
			expect(OfficeGlowRules.lantern(true, 10, 0)).to.equal(OfficeGlowRules.LANTERN_BRIGHTNESS)
		end)

		it("lights teammates' lanterns nearby unless the graphics are low", function()
			expect(OfficeGlowRules.lantern(false, 8, 20)).to.equal(OfficeGlowRules.LANTERN_BRIGHTNESS)
			expect(OfficeGlowRules.lantern(false, OfficeGlowRules.LOW_QUALITY, 20)).to.equal(nil)
		end)

		it("culls teammates' lanterns far away", function()
			expect(OfficeGlowRules.lantern(false, 8, OfficeGlowRules.CULL_RANGE + 1)).to.equal(nil)
		end)
	end)

	describe("lowEnd", function()
		it("treats quality 1 to LOW_QUALITY as low and Automatic as not", function()
			expect(OfficeGlowRules.lowEnd(1)).to.equal(true)
			expect(OfficeGlowRules.lowEnd(OfficeGlowRules.LOW_QUALITY)).to.equal(true)
			expect(OfficeGlowRules.lowEnd(OfficeGlowRules.LOW_QUALITY + 1)).to.equal(false)
			expect(OfficeGlowRules.lowEnd(0)).to.equal(false)
		end)
	end)
end
