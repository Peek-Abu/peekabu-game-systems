local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InputMovementLockTracker = require(ReplicatedStorage.Client.Features.Input.State.InputMovementLockTracker)

return function()
	it("is free until someone locks it", function()
		local tracker = InputMovementLockTracker.new()
		expect(tracker:isLocked()).to.equal(false)
		tracker:set("hide", true)
		expect(tracker:isLocked()).to.equal(true)
	end)

	it("stays locked until every owner has let go (hiding while a menu is open)", function()
		local tracker = InputMovementLockTracker.new()
		tracker:set("hide", true)
		tracker:set("ui", true)
		tracker:set("hide", false)
		expect(tracker:isLocked()).to.equal(true)
		tracker:set("ui", false)
		expect(tracker:isLocked()).to.equal(false)
	end)

	it("counts one owner once, however often it locks or unlocks", function()
		local tracker = InputMovementLockTracker.new()
		tracker:set("film", true)
		tracker:set("film", true)
		tracker:set("film", false)
		expect(tracker:isLocked()).to.equal(false)
		tracker:set("film", false)
		expect(tracker:isLocked()).to.equal(false)
	end)

	it("lists the owners holding it, sorted", function()
		local tracker = InputMovementLockTracker.new()
		tracker:set("ui", true)
		tracker:set("film", true)
		local owners = tracker:owners()
		expect(#owners).to.equal(2)
		expect(owners[1]).to.equal("film")
		expect(owners[2]).to.equal("ui")
	end)
end
