local InputActionTracker = require(script.Parent.InputActionTracker)

return function()
	it("begins an action on its first key and reports the transition", function()
		local tracker = InputActionTracker.new()
		expect(tracker:press("sprint", "LeftShift")).to.equal(true)
		expect(tracker:isHeld("sprint")).to.equal(true)
	end)

	it("does not begin again while another key already holds it", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		expect(tracker:press("sprint", "ButtonL3")).to.equal(false)
	end)

	it("ends only when the last holding key is released", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		tracker:press("sprint", "ButtonL3")
		expect(tracker:release("sprint", "LeftShift")).to.equal(false)
		expect(tracker:isHeld("sprint")).to.equal(true)
		expect(tracker:release("sprint", "ButtonL3")).to.equal(true)
		expect(tracker:isHeld("sprint")).to.equal(false)
	end)

	it("ignores a release for an action that is not held", function()
		local tracker = InputActionTracker.new()
		expect(tracker:release("sprint", "LeftShift")).to.equal(false)
	end)

	it("dropUnreachable ends every held action whose context is no longer reachable", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		tracker:press("confirm", "Return")
		local contextOf = { sprint = "gameplay", confirm = "ui" }
		local ended = tracker:dropUnreachable(function(id)
			return contextOf[id]
		end, { ui = true })
		expect(#ended).to.equal(1)
		expect(ended[1]).to.equal("sprint")
		expect(tracker:isHeld("sprint")).to.equal(false)
		expect(tracker:isHeld("confirm")).to.equal(true)
	end)

	it("a key released after its action was dropped does not end it twice", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		tracker:dropUnreachable(function()
			return "gameplay"
		end, {})
		expect(tracker:release("sprint", "LeftShift")).to.equal(false)
	end)

	it("held lists every held action, sorted", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		tracker:press("aim", "MouseButton2")
		local held = tracker:held()
		expect(#held).to.equal(2)
		expect(held[1]).to.equal("aim")
		expect(held[2]).to.equal("sprint")
	end)

	it("clear ends everything and returns what was held", function()
		local tracker = InputActionTracker.new()
		tracker:press("sprint", "LeftShift")
		local ended = tracker:clear()
		expect(#ended).to.equal(1)
		expect(tracker:isHeld("sprint")).to.equal(false)
	end)
end
