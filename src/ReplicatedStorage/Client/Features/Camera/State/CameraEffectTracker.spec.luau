local CameraEffectTracker = require(script.Parent.CameraEffectTracker)

return function()
	it("starts calm", function()
		local tracker = CameraEffectTracker.new(1)
		expect(tracker:trauma()).to.equal(0)
		expect(tracker:fovOffset()).to.equal(0)
	end)

	it("accumulates trauma up to 1 and decays it on step", function()
		local tracker = CameraEffectTracker.new(1)
		tracker:addTrauma(0.6)
		tracker:addTrauma(0.6)
		expect(tracker:trauma()).to.equal(1)
		tracker:step(0.25)
		expect(tracker:trauma()).to.be.near(0.75)
	end)

	it("sums active FOV kicks and drops finished ones", function()
		local tracker = CameraEffectTracker.new(1)
		tracker:kickFov(10, 1)
		tracker:kickFov(-4, 0.5)
		expect(tracker:fovOffset()).to.equal(6)
		tracker:step(0.5)
		-- The first kick is half way (10 × 0.5² = 2.5); the second just finished.
		expect(tracker:fovOffset()).to.be.near(2.5)
		expect(tracker:activeKicks()).to.equal(1)
		tracker:step(0.6)
		expect(tracker:fovOffset()).to.equal(0)
		expect(tracker:activeKicks()).to.equal(0)
	end)

	it("ignores a kick with no duration", function()
		local tracker = CameraEffectTracker.new(1)
		tracker:kickFov(10, 0)
		expect(tracker:activeKicks()).to.equal(0)
	end)

	it("reset clears trauma and kicks", function()
		local tracker = CameraEffectTracker.new(1)
		tracker:addTrauma(0.5)
		tracker:kickFov(5, 1)
		tracker:reset()
		expect(tracker:trauma()).to.equal(0)
		expect(tracker:fovOffset()).to.equal(0)
	end)
end
