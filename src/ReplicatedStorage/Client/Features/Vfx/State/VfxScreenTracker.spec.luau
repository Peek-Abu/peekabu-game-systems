local VfxScreenTracker = require(script.Parent.VfxScreenTracker)

return function()
	it("starts with no requests", function()
		expect(#VfxScreenTracker.new():list()).to.equal(0)
	end)

	it("lists requests in the order they were made", function()
		local tracker = VfxScreenTracker.new()
		tracker:add({ blur = 4 })
		tracker:add({ blur = 8 })
		local list = tracker:list()
		expect(#list).to.equal(2)
		expect(list[1].blur).to.equal(4)
		expect(list[2].blur).to.equal(8)
	end)

	it("removes by token from anywhere", function()
		local tracker = VfxScreenTracker.new()
		local first = tracker:add({ blur = 4 })
		tracker:add({ blur = 8 })
		expect(tracker:remove(first)).to.equal(true)
		expect(tracker:list()[1].blur).to.equal(8)
		expect(tracker:remove(first)).to.equal(false)
	end)

	it("update replaces a live request and reports unknown tokens", function()
		local tracker = VfxScreenTracker.new()
		local token = tracker:add({ blur = 4 })
		expect(tracker:update(token, { blur = 12 })).to.equal(true)
		expect(tracker:list()[1].blur).to.equal(12)
		expect(tracker:update(999, { blur = 1 })).to.equal(false)
	end)
end
