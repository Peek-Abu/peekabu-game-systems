local Store = require(script.Parent.UICompanyStore)
return function()
	describe("company clipboard", function()
		afterEach(function()
			Store.reset()
		end)
		it("remembers the last tab across close and shortcut toggle", function()
			Store.open("workOrder")
			expect(Store.visible()).to.equal(true)
			Store.close()
			expect(Store.visible()).to.equal(false)
			Store.toggle()
			expect(Store.selectedTab()).to.equal("workOrder")
			Store.select("timecard")
			expect(Store.visible()).to.equal(true)
			Store.toggle()
			expect(Store.visible()).to.equal(false)
			Store.toggle()
			expect(Store.selectedTab()).to.equal("timecard")
		end)
		it("allows optional tracking independently of clipboard visibility", function()
			Store.togglePin()
			Store.close()
			expect(Store.pinned()).to.equal(true)
			Store.togglePin()
			expect(Store.pinned()).to.equal(false)
		end)
	end)
end
