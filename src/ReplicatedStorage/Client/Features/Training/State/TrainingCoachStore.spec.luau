local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TrainingConstants = require(ReplicatedStorage.Shared.Features.Training.Data.TrainingConstants)
local TrainingCoachStore = require(ReplicatedStorage.Client.Features.Training.State.TrainingCoachStore)

return function()
	beforeEach(function()
		TrainingCoachStore.reset()
	end)

	describe("line", function()
		it("shows the stop's own line when nothing is said over it", function()
			TrainingCoachStore.setStop(1)
			expect(TrainingCoachStore.line(0)).to.equal(TrainingConstants.COACH.dust)
		end)

		it("shows a said line until it runs out, then the stop's again", function()
			TrainingCoachStore.setStop(1)
			TrainingCoachStore.say(TrainingConstants.COACH.caught, 10, 3)
			expect(TrainingCoachStore.line(11)).to.equal(TrainingConstants.COACH.caught)
			expect(TrainingCoachStore.line(14)).to.equal(TrainingConstants.COACH.dust)
		end)

		it("keeps a said line with no time limit until it is cleared", function()
			TrainingCoachStore.say(TrainingConstants.COACH.shop, 0, nil)
			expect(TrainingCoachStore.line(1000)).to.equal(TrainingConstants.COACH.shop)
			TrainingCoachStore.quiet()
			expect(TrainingCoachStore.line(1000)).to.equal(nil)
		end)

		it("follows the situation: carrying at the treasure stop", function()
			TrainingCoachStore.setStop(2)
			TrainingCoachStore.setSituation({ stopDone = false, carrying = true, hidden = false })
			expect(TrainingCoachStore.line(0)).to.equal(TrainingConstants.COACH.carrying)
		end)

		it("says nothing outside a run", function()
			expect(TrainingCoachStore.line(0)).to.equal(nil)
		end)
	end)

	describe("situation", function()
		it("forgets the last stop's situation on a new stop", function()
			TrainingCoachStore.setStop(4)
			TrainingCoachStore.setSituation({ stopDone = false, carrying = false, hidden = true })
			TrainingCoachStore.setStop(5)
			expect(TrainingCoachStore.situation().hidden).to.equal(false)
		end)
	end)

	describe("caught and finish", function()
		it("remembers the latest catch and the finish payout until reset", function()
			TrainingCoachStore.caught(12, 2)
			TrainingCoachStore.finished(100)
			expect(TrainingCoachStore.catch().at).to.equal(12)
			expect(TrainingCoachStore.catch().lives).to.equal(2)
			expect(TrainingCoachStore.finish().gleam).to.equal(100)
			TrainingCoachStore.reset()
			expect(TrainingCoachStore.catch()).to.equal(nil)
			expect(TrainingCoachStore.finish()).to.equal(nil)
		end)
	end)
end
