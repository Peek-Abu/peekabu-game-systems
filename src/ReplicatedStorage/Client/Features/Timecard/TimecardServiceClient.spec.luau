local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Service = require(script.Parent.TimecardServiceClient)
local State = require(ReplicatedStorage.Client.Features.StateSync.State.StateSyncClientStore)
return function()
	describe("TimecardServiceClient feedback", function()
		local sent, expires, oldCard
		it("opens the matching physical entrance tab without punching", function()
			local Company = require(ReplicatedStorage.Client.Features.UI.State.UICompanyStore)
			Service:_receiveOpen(false)
			expect(Company.selectedTab()).to.equal("workOrder")
			expect(Company.visible()).to.equal(true)
			Company.close()
			Service:_receiveOpen(true)
			expect(Company.selectedTab()).to.equal("timecard")
			expect(sent).to.equal(0)
		end)
		beforeEach(function()
			sent = 0
			expires = {}
			oldCard = State.timecard()
			State.timecard({ week = 0, punched = {}, weeks = 0 })
			Service:stop()
			Service:_setDeps({
				send = function()
					sent += 1
				end,
				delay = function(_seconds, callback)
					table.insert(expires, callback)
				end,
			})
		end)
		afterEach(function()
			Service:stop()
			Service:_setDeps(nil)
			State.timecard(oldCard)
		end)
		it("sends once while pending and clears pending on a server result", function()
			Service:punch()
			Service:punch()
			expect(sent).to.equal(1)
			expect(Service.pending()).to.equal(true)
			expect(Service.feedback()).to.equal("Punching...")
			Service:_receiveResult("Already punched today")
			expect(Service.pending()).to.equal(false)
			expect(Service.feedback()).to.equal("Already punched today")
			expires[1]()
			expect(Service.feedback()).to.equal("Already punched today")
		end)
		it("permits retry on timeout and ignores expiry from the older request", function()
			Service:punch()
			expires[1]()
			expect(Service.pending()).to.equal(false)
			expect(Service.feedback()).to.equal("No response. Please try again.")
			Service:punch()
			expires[1]()
			expect(Service.pending()).to.equal(true)
			expect(sent).to.equal(2)
			Service:stop()
			expires[2]()
			expect(Service.feedback()).to.equal("")
			expect(Service.pending()).to.equal(false)
		end)
	end)
end
