local ReplicatedStorage = game:GetService("ReplicatedStorage")

local OccupantTrailSystem = require(script.Parent.OccupantTrailSystem)
local C = require(ReplicatedStorage.Shared.Features.Occupant.Data.OccupantConstants)

return function()
	describe("shouldDrop", function()
		it("only remembers the first point", function()
			expect(OccupantTrailSystem.shouldDrop(nil, Vector3.new(10, 0, 0))).to.equal(false)
		end)

		it("lays a feather every FEATHER_SPACING flat studs", function()
			local last = Vector3.new(0, 3, 0)
			expect(OccupantTrailSystem.shouldDrop(last, Vector3.new(C.FEATHER_SPACING - 0.1, 3, 0))).to.equal(false)
			expect(OccupantTrailSystem.shouldDrop(last, Vector3.new(C.FEATHER_SPACING, 3, 0))).to.equal(true)
		end)

		it("ignores height (a hop is not a step)", function()
			expect(OccupantTrailSystem.shouldDrop(Vector3.zero, Vector3.new(0, 10, 0))).to.equal(false)
		end)
	end)

	describe("feather", function()
		it("lies flat on the floor, green, and never gets in the way", function()
			local part = OccupantTrailSystem.feather(Vector3.new(4, 1, 2), 0)
			expect(part.Color).to.equal(C.FEATHER_COLOR)
			expect(part.Anchored).to.equal(true)
			expect(part.CanCollide).to.equal(false)
			expect(part.CanTouch).to.equal(false)
			expect(part.CanQuery).to.equal(false)
			expect(part.CastShadow).to.equal(false)
			expect(part.Size.Y < 0.1).to.equal(true)
			expect(part.Position.X).to.be.near(4, 1e-6)
			expect(part.Position.Y - part.Size.Y / 2).to.be.near(1, 1e-6)
			expect(part.Parent).to.equal(nil)
			part:Destroy()
		end)

		it("turns by its yaw", function()
			local part = OccupantTrailSystem.feather(Vector3.zero, math.pi / 2)
			expect(part.CFrame.LookVector.X).to.be.near(-1, 1e-6)
			part:Destroy()
		end)
	end)
end
