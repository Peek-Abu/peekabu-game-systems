local OccupantPaStore = require(script.Parent.OccupantPaStore)

return function()
	afterEach(function()
		OccupantPaStore.clear()
	end)

	it("shows a line until its time", function()
		OccupantPaStore.show("The Manager will see you now.", false, 10)
		expect(OccupantPaStore.notice().line).to.equal("The Manager will see you now.")
		expect(OccupantPaStore.notice().callout).to.equal(false)
		OccupantPaStore.expire(9)
		expect(OccupantPaStore.notice()).to.be.ok()
		OccupantPaStore.expire(10)
		expect(OccupantPaStore.notice()).to.equal(nil)
	end)

	it("replaces a line with a newer one", function()
		OccupantPaStore.show("Productivity is being monitored.", false, 10)
		OccupantPaStore.show("Pippa. My office.", true, 20)
		OccupantPaStore.expire(15)
		expect(OccupantPaStore.notice().line).to.equal("Pippa. My office.")
		expect(OccupantPaStore.notice().callout).to.equal(true)
	end)
end
