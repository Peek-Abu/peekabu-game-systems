local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TrainingRules = require(ReplicatedStorage.Shared.Features.Training.Rules.TrainingRules)

return function()
	describe("fresh", function()
		it("starts unfinished with no runs", function()
			local fresh = TrainingRules.fresh()
			expect(fresh.finished).to.equal(false)
			expect(fresh.runs).to.equal(0)
		end)

		it("hands out a new table each time", function()
			expect(TrainingRules.fresh()).never.to.equal(TrainingRules.fresh())
		end)
	end)

	describe("validate", function()
		it("accepts a fresh and a finished slice", function()
			expect(TrainingRules.validate({ finished = false, runs = 0, toured = false })).to.equal(true)
			expect(TrainingRules.validate({ finished = true, runs = 3, toured = true })).to.equal(true)
		end)

		it("refuses a missing slice, a bad flag and a bad run count", function()
			expect(TrainingRules.validate(nil)).to.equal(false)
			expect(TrainingRules.validate({ runs = 0, toured = false })).to.equal(false)
			expect(TrainingRules.validate({ finished = false, runs = -1, toured = false })).to.equal(false)
			expect(TrainingRules.validate({ finished = false, runs = 1.5, toured = false })).to.equal(false)
		end)

		it("refuses a missing tour flag and a tour before training", function()
			expect(TrainingRules.validate({ finished = false, runs = 0 })).to.equal(false)
			expect(TrainingRules.validate({ finished = false, runs = 1, toured = true })).to.equal(false)
		end)

		it("refuses finished with no run behind it", function()
			expect(TrainingRules.validate({ finished = true, runs = 0, toured = false })).to.equal(false)
		end)
	end)

	describe("isNew", function()
		it("is new until training is finished", function()
			expect(TrainingRules.isNew({ finished = false, runs = 0, toured = false })).to.equal(true)
			expect(TrainingRules.isNew({ finished = true, runs = 1, toured = false })).to.equal(false)
		end)

		it("treats a slice that is not loaded yet as not new, so nothing nags before the save loads", function()
			expect(TrainingRules.isNew(nil)).to.equal(false)
		end)
	end)

	describe("finish", function()
		it("pays the reward only the first time", function()
			local slice = TrainingRules.fresh()
			expect(TrainingRules.finish(slice)).to.equal(true)
			expect(slice.finished).to.equal(true)
			expect(slice.runs).to.equal(1)
			expect(TrainingRules.finish(slice)).to.equal(false)
			expect(slice.runs).to.equal(2)
		end)
	end)

	describe("tour", function()
		it("is due once, after training", function()
			local slice = TrainingRules.fresh()
			expect(TrainingRules.tour(slice)).to.equal(false)
			TrainingRules.finish(slice)
			expect(TrainingRules.tour(slice)).to.equal(true)
			expect(slice.toured).to.equal(true)
			expect(TrainingRules.tour(slice)).to.equal(false)
		end)
	end)
end
