local ShiftCurrencyUtils = require(script.Parent.ShiftCurrencyUtils)

return function()
	it("pays associates in Credits, written as a word after the number (no sign, no emoji)", function()
		expect(ShiftCurrencyUtils.NAME).to.equal("Credits")
	end)

	describe("amount", function()
		it("writes a whole amount of Credits", function()
			expect(ShiftCurrencyUtils.amount(45)).to.equal("45 Credits")
		end)

		it("rounds to a whole amount and never reads below zero", function()
			expect(ShiftCurrencyUtils.amount(14.6)).to.equal("15 Credits")
			expect(ShiftCurrencyUtils.amount(-3)).to.equal("0 Credits")
			expect(ShiftCurrencyUtils.amount(0 / 0)).to.equal("0 Credits")
		end)
	end)

	describe("unknown", function()
		it("hides an unappraised value", function()
			expect(ShiftCurrencyUtils.unknown()).to.equal("??? Credits")
		end)
	end)

	describe("gain", function()
		it("signs what was just earned", function()
			expect(ShiftCurrencyUtils.gain(40)).to.equal("+40 Credits")
			expect(ShiftCurrencyUtils.gain(0)).to.equal("+0 Credits")
		end)
	end)

	describe("signed", function()
		it("keeps an already-formatted sign in front and names the currency after", function()
			expect(ShiftCurrencyUtils.signed("+40")).to.equal("+40 Credits")
			expect(ShiftCurrencyUtils.signed("-5")).to.equal("-5 Credits")
		end)

		it("names the currency after an unsigned amount", function()
			expect(ShiftCurrencyUtils.signed("40")).to.equal("40 Credits")
		end)
	end)

	describe("gloom", function()
		it("writes the contract's progress the way the gauge reads it", function()
			expect(ShiftCurrencyUtils.gloom(340, 500)).to.equal("Gloom 340 / 500")
			expect(ShiftCurrencyUtils.gloom(12.4, 500)).to.equal("Gloom 12 / 500")
		end)

		it("writes the contract as an order", function()
			expect(ShiftCurrencyUtils.contract(500)).to.equal("Remove 500 Gloom")
		end)
	end)

	describe("labels", function()
		it("names the earned total in capitals for the plates and the review", function()
			expect(ShiftCurrencyUtils.earnedLabel()).to.equal("EARNED")
		end)
	end)
end
