local Rules = require(script.Parent.VacuumEquipmentRules)
return function()
	describe("vacuum equipment authority", function()
		it("requires active crew, actual equip, empty hands and a living character", function()
			expect(Rules.canVacuum(true, true, false, true)).to.equal(true)
			expect(Rules.canVacuum(false, true, false, true)).to.equal(false)
			expect(Rules.canVacuum(true, false, false, true)).to.equal(false)
			expect(Rules.canVacuum(true, true, true, true)).to.equal(false)
			expect(Rules.canVacuum(true, true, false, false)).to.equal(false)
		end)
		it("equips on entry or respawn without overriding a manual stow", function()
			expect(Rules.shouldEquip(true, false, false, false)).to.equal(true)
			expect(Rules.shouldEquip(false, false, false, false)).to.equal(false)
			expect(Rules.shouldEquip(true, false, true, true)).to.equal(false)
		end)
		it("restores after cargo only if the vacuum was selected before pickup", function()
			expect(Rules.shouldEquip(false, true, false, true)).to.equal(true)
			expect(Rules.shouldEquip(false, true, false, false)).to.equal(false)
			expect(Rules.shouldEquip(false, true, true, true)).to.equal(false)
		end)
	end)
end
