local EventRules = require(script.Parent.EventRules)

return function()
	it("accepts a whole, non-negative day number and the events whose tab was shown", function()
		expect(EventRules.validate({ day = 0, shown = {} })).to.equal(true)
		expect(EventRules.validate({ day = 20000, shown = { harvest = true } })).to.equal(true)
	end)

	it("refuses a broken slice", function()
		expect(EventRules.validate({ day = -1, shown = {} })).to.equal(false)
		expect(EventRules.validate({ day = 1.5, shown = {} })).to.equal(false)
		expect(EventRules.validate({ day = "1", shown = {} })).to.equal(false)
		expect(EventRules.validate({ day = 0 })).to.equal(false)
		expect(EventRules.validate({ day = 0, shown = { attic = true } })).to.equal(false)
		expect(EventRules.validate({ day = 0, shown = { harvest = 1 } })).to.equal(false)
		expect(EventRules.validate({})).to.equal(false)
	end)

	it("reads a tab-shown request: a registered event's id, else nil", function()
		expect(EventRules.parseShown({ event = "harvest" })).to.equal("harvest")
		expect(EventRules.parseShown({ event = "attic" })).to.equal(nil)
		expect(EventRules.parseShown({ event = 3 })).to.equal(nil)
		expect(EventRules.parseShown("harvest")).to.equal(nil)
		expect(EventRules.parseShown(nil)).to.equal(nil)
	end)
end
