local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DepotModeRules = require(script.Parent.DepotModeRules)
local ShiftNightConstants = require(ReplicatedStorage.Shared.Features.Shift.Data.ShiftNightConstants)

return function()
	describe("parse", function()
		it("keeps the two modes", function()
			expect(DepotModeRules.parse("night")).to.equal("night")
			expect(DepotModeRules.parse("quick")).to.equal("quick")
		end)

		it("reads anything else as the default mode (Night Shift)", function()
			expect(ShiftNightConstants.DEFAULT_MODE).to.equal("night")
			expect(DepotModeRules.parse(nil)).to.equal("night")
			expect(DepotModeRules.parse("Quick")).to.equal("night")
			expect(DepotModeRules.parse("floors")).to.equal("night")
			expect(DepotModeRules.parse(1)).to.equal("night")
			expect(DepotModeRules.parse({ "quick" })).to.equal("night")
		end)
	end)

	describe("isMode", function()
		it("accepts only the two modes", function()
			expect(DepotModeRules.isMode("night")).to.equal(true)
			expect(DepotModeRules.isMode("quick")).to.equal(true)
			expect(DepotModeRules.isMode("")).to.equal(false)
			expect(DepotModeRules.isMode("training")).to.equal(false)
			expect(DepotModeRules.isMode(nil)).to.equal(false)
			expect(DepotModeRules.isMode(true)).to.equal(false)
		end)
	end)

	describe("decode", function()
		it("keeps good picks and drops bad ones", function()
			local picks = DepotModeRules.decode({ pad1 = "quick", pad2 = "night", pad3 = "nope", pad4 = 3 })
			expect(picks.pad1).to.equal("quick")
			expect(picks.pad2).to.equal("night")
			expect(picks.pad3).to.equal(nil)
			expect(picks.pad4).to.equal(nil)
		end)

		it("reads a missing or malformed entry as no picks", function()
			expect(next(DepotModeRules.decode(nil))).to.equal(nil)
			expect(next(DepotModeRules.decode("quick"))).to.equal(nil)
		end)
	end)

	describe("modeOf", function()
		it("is the truck's pick, else the default", function()
			local picks = { pad1 = "quick" }
			expect(DepotModeRules.modeOf(picks, "pad1")).to.equal("quick")
			expect(DepotModeRules.modeOf(picks, "pad2")).to.equal("night")
			expect(DepotModeRules.modeOf(picks, nil)).to.equal("night")
		end)
	end)
end
