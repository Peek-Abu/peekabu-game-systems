local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DepotPlaceRules = require(script.Parent.DepotPlaceRules)
local DepotPlaceConstants = require(ReplicatedStorage.Shared.Features.Depot.Data.DepotPlaceConstants)

return function()
	describe("owns", function()
		it("always owns the free Office, even with no saved places", function()
			expect(DepotPlaceRules.owns(nil, "office")).to.equal(true)
			expect(DepotPlaceRules.owns(DepotPlaceRules.fresh(), "office")).to.equal(true)
		end)

		it("owns the School only once it is bought", function()
			expect(DepotPlaceRules.owns(nil, "school")).to.equal(false)
			expect(DepotPlaceRules.owns(DepotPlaceRules.fresh(), "school")).to.equal(false)
			expect(DepotPlaceRules.owns({ owned = { school = true } }, "school")).to.equal(true)
		end)
	end)

	describe("canBuy", function()
		local price = DepotPlaceConstants.PLACES.school.price

		it("puts the School up for sale at its Credits price (paying is the Shop's payOps)", function()
			expect(price > 0).to.equal(true)
			expect(DepotPlaceRules.price("school")).to.equal(price)
			local ok, reason = DepotPlaceRules.canBuy(DepotPlaceRules.fresh(), "school")
			expect(ok).to.equal(true)
			expect(reason).to.equal(nil)
		end)

		it("never sells a place twice, nor the free Office", function()
			expect(DepotPlaceRules.canBuy({ owned = { school = true } }, "school")).to.equal(false)
			expect(DepotPlaceRules.canBuy(DepotPlaceRules.fresh(), "office")).to.equal(false)
			expect(DepotPlaceRules.canBuy(nil, "school")).to.equal(false)
		end)

		it("refuses a place it does not know", function()
			local ok, reason = DepotPlaceRules.canBuy(DepotPlaceRules.fresh(), "mall")
			expect(ok).to.equal(false)
			expect(reason).to.equal("unknown place")
		end)
	end)

	describe("unlock", function()
		it("records the School once, and says whether it changed", function()
			local places = DepotPlaceRules.fresh()
			expect(DepotPlaceRules.unlock(places, "school")).to.equal(true)
			expect(places.owned.school).to.equal(true)
			expect(DepotPlaceRules.unlock(places, "school")).to.equal(false)
		end)

		it("never records the free Office or an unknown place", function()
			local places = DepotPlaceRules.fresh()
			expect(DepotPlaceRules.unlock(places, "office")).to.equal(false)
			expect(DepotPlaceRules.unlock(places, "mall")).to.equal(false)
			expect(next(places.owned)).to.equal(nil)
		end)
	end)

	describe("validate", function()
		it("accepts a fresh slice and a bought School", function()
			expect(DepotPlaceRules.validate(DepotPlaceRules.fresh())).to.equal(true)
			expect(DepotPlaceRules.validate({ owned = { school = true } })).to.equal(true)
		end)

		it("rejects an unknown place, a free one, a non-true flag or a missing table", function()
			expect(DepotPlaceRules.validate({ owned = { mall = true } })).to.equal(false)
			expect(DepotPlaceRules.validate({ owned = { office = true } })).to.equal(false)
			expect(DepotPlaceRules.validate({ owned = { school = 1 } })).to.equal(false)
			expect(DepotPlaceRules.validate({})).to.equal(false)
		end)
	end)

	describe("danger", function()
		it("rates the Office the easiest and the School harder, inside the meter", function()
			local office = DepotPlaceRules.danger("office")
			local school = DepotPlaceRules.danger("school")
			expect(office).to.equal(1)
			expect(school).to.equal(2)
			expect(school > office).to.equal(true)
			expect(school <= DepotPlaceConstants.DANGER_MAX).to.equal(true)
		end)
	end)

	describe("parseBuy", function()
		it("reads a place and the Gleam agreed for the rest", function()
			local request = DepotPlaceRules.parseBuy({ map = "school", gleam = 12 })
			expect(request.map).to.equal("school")
			expect(request.gleam).to.equal(12)
			expect(DepotPlaceRules.parseBuy({ map = "school" }).gleam).to.equal(0)
		end)

		it("drops anything malformed", function()
			expect(DepotPlaceRules.parseBuy("school")).to.equal(nil)
			expect(DepotPlaceRules.parseBuy({ map = "mall", gleam = 0 })).to.equal(nil)
			expect(DepotPlaceRules.parseBuy({ map = "school", gleam = -1 })).to.equal(nil)
			expect(DepotPlaceRules.parseBuy({ map = "school", gleam = 1.5 })).to.equal(nil)
			expect(DepotPlaceRules.parseBuy({ map = "school", gleam = 0 / 0 })).to.equal(nil)
			expect(DepotPlaceRules.parseBuy({ map = "school", gleam = "5" })).to.equal(nil)
		end)
	end)

	describe("parse", function()
		it("reads only an exact place id", function()
			expect(DepotPlaceRules.parse("school")).to.equal("school")
			expect(DepotPlaceRules.parse("office")).to.equal("office")
			expect(DepotPlaceRules.parse("School")).to.equal(nil)
			expect(DepotPlaceRules.parse(5)).to.equal(nil)
			expect(DepotPlaceRules.parse(nil)).to.equal(nil)
		end)
	end)
end
