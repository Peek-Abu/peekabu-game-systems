local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AdminBanUtils = require(ReplicatedStorage.Shared.Features.Admin.Utils.AdminBanUtils)

return function()
	describe("config", function()
		it("bans one account from the whole experience for whole days, alts too", function()
			local config = AdminBanUtils.config(123, 3, "Cheating")
			expect(config).to.be.ok()
			expect(config.UserIds[1]).to.equal(123)
			expect(#config.UserIds).to.equal(1)
			expect(config.Duration).to.equal(3 * 86400)
			expect(config.ApplyToUniverse).to.equal(true)
			expect(config.ExcludeAltAccounts).to.equal(false)
			expect(config.DisplayReason).to.equal("Cheating")
		end)

		it("makes 0 days a permanent ban", function()
			expect(AdminBanUtils.config(123, 0, "x").Duration).to.equal(-1)
		end)

		it("refuses a bad user id, bad days and an empty or too-long reason", function()
			local ok, reason = AdminBanUtils.config(0, 1, "x")
			expect(ok).to.equal(nil)
			expect(type(reason)).to.equal("string")
			expect(AdminBanUtils.config(1.5, 1, "x")).to.equal(nil)
			expect(AdminBanUtils.config(1, -1, "x")).to.equal(nil)
			expect(AdminBanUtils.config(1, 2.5, "x")).to.equal(nil)
			expect(AdminBanUtils.config(1, 1, "   ")).to.equal(nil)
			expect(AdminBanUtils.config(1, 1, string.rep("a", 401))).to.equal(nil)
		end)
	end)

	describe("unbanConfig", function()
		it("lifts the ban everywhere in the experience", function()
			local config = AdminBanUtils.unbanConfig(77)
			expect(config.UserIds[1]).to.equal(77)
			expect(config.ApplyToUniverse).to.equal(true)
			expect(AdminBanUtils.unbanConfig(-4)).to.equal(nil)
		end)
	end)
end
