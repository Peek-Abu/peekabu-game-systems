return function()
	local CollectionService = game:GetService("CollectionService")
	local ArtVisualSystem = require(script.Parent.ArtVisualSystem)
	local Art
	local kitRoot, mapA, mapB
	local function folder(parent, name)
		local found = parent:FindFirstChild(name)
		if found then
			return found
		end
		local result = Instance.new("Folder")
		result.Name = name
		result.Parent = parent
		return result
	end
	local function template(kit, key, transparency)
		local model = Instance.new("Model")
		model.Name = key
		model:SetAttribute("RuntimeApproved", true)
		model:SetAttribute("BaseSize", Vector3.new(2, 2, 2))
		local part = Instance.new("Part")
		part.Size = Vector3.new(2, 2, 2)
		part.CFrame = CFrame.new(0, 1, 0)
		part.Transparency = transparency or 0
		part.Parent = model
		model.WorldPivot = CFrame.new()
		model.Parent = folder(folder(kitRoot, kit), "cargo")
		return model
	end
	local function root(parent)
		local result = Instance.new("Part")
		result.Size = Vector3.new(4, 8, 6)
		result.Anchored = true
		result.CFrame = CFrame.new(10, 4, 20)
		result.Parent = parent
		return result
	end
	beforeEach(function()
		kitRoot = Instance.new("Folder")
		Art = ArtVisualSystem.new(kitRoot)
		mapA = Instance.new("Model")
		mapA:SetAttribute("ArtKitId", "art-spec-map-a")
		mapB = Instance.new("Model")
		mapB:SetAttribute("ArtKitId", "art-spec-map-b")
	end)
	afterEach(function()
		mapA:Destroy()
		mapB:Destroy()
		kitRoot:Destroy()
	end)
	describe("ArtVisualSystem", function()
		it("selects two map contexts and explicit overrides independently", function()
			template("art-spec-map-a", "monitor")
			template("art-spec-map-b", "monitor")
			local a, b = root(mapA), root(mapB)
			expect(Art.resolveKit(a)).to.equal("art-spec-map-a")
			expect(Art.resolveKit(b)).to.equal("art-spec-map-b")
			expect(Art.attach(a, "cargo", "monitor"):GetAttribute("ArtKitId")).to.equal("art-spec-map-a")
			expect(Art.attach(b, "cargo", "monitor"):GetAttribute("ArtKitId")).to.equal("art-spec-map-b")
			expect(Art.attach(a, "cargo", "monitor", "art-spec-map-b"):GetAttribute("ArtKitId")).to.equal(
				"art-spec-map-b"
			)
			expect(#a:GetChildren()).to.equal(1)
		end)
		it("keeps fallback roots and existing attached visuals when a template is missing or unsafe", function()
			local a = root(mapA)
			expect(Art.attach(a, "cargo", "monitor")).to.equal(nil)
			expect(a.Transparency).to.equal(0)
			local source = template("art-spec-map-a", "monitor")
			source:SetAttribute("RuntimeApproved", false)
			expect(Art.attach(a, "cargo", "monitor")).to.equal(nil)
			source:SetAttribute("RuntimeApproved", true)
			local visual = Art.attach(a, "cargo", "monitor")
			Instance.new("Script").Parent = source
			expect(Art.attach(a, "cargo", "monitor")).to.equal(nil)
			expect(visual.Parent).to.equal(a)
			expect(a.Transparency).to.equal(1)
		end)
		it("aligns the back of mounted visuals with their authoritative wall footprint", function()
			template("art-spec-map-a", "monitor")
			local a = root(mapA)
			a:SetAttribute("ArtWallMounted", true)
			local visual = Art.attach(a, "cargo", "monitor")
			local part = visual:FindFirstChildWhichIsA("BasePart", true)
			local localCenter = a.CFrame:PointToObjectSpace(part.Position)
			expect(localCenter.Z + part.Size.Z / 2).to.equal(a.Size.Z / 2)
		end)

		it("scales an authored support height independently of the whole model bounds", function()
			local source = template("art-spec-map-a", "monitor")
			source:SetAttribute("SupportSurfaceY", 1.5)
			local a = root(mapA)
			Art.attach(a, "cargo", "monitor")
			expect(a:GetAttribute("ArtSupportSurfaceY")).to.equal(3)
			expect(source:GetAttribute("SupportSurfaceY")).to.equal(1.5)
			Art.detach(a)
			expect(a:GetAttribute("ArtSupportSurfaceY")).to.equal(nil)
		end)

		it(
			"reports the art's own height as the support surface when a Uniform fit leaves it under the proxy",
			function()
				-- A 2 x 2 x 2 template in a 4 x 8 x 6 proxy scales by 2: 4 high, 4 under the proxy's top.
				template("art-spec-map-a", "monitor")
				local a = root(mapA)
				Art.attach(a, "cargo", "monitor")
				expect(a:GetAttribute("ArtSupportSurfaceY")).to.equal(4)
				Art.detach(a)
				expect(a:GetAttribute("ArtSupportSurfaceY")).to.equal(nil)
			end
		)

		it("leaves the support surface unset when the art reaches the proxy's top", function()
			template("art-spec-map-a", "monitor")
			local a = root(mapA)
			a.Size = Vector3.new(4, 4, 4)
			Art.attach(a, "cargo", "monitor")
			expect(a:GetAttribute("ArtSupportSurfaceY")).to.equal(nil)
		end)

		it("preserves root physics and tags, fits at its floor, and follows moving roots", function()
			template("art-spec-map-a", "monitor", 0.35)
			local a = root(mapA)
			CollectionService:AddTag(a, "ArtSpecGameplay")
			local visual = Art.attach(a, "cargo", "monitor", nil, true)
			local part = visual:FindFirstChildWhichIsA("BasePart", true)
			expect(a.Size).to.equal(Vector3.new(4, 8, 6))
			expect(a.CanCollide).to.equal(true)
			expect(CollectionService:HasTag(a, "ArtSpecGameplay")).to.equal(true)
			expect(part.Size).to.equal(Vector3.new(4, 4, 4))
			expect(part.Position).to.equal(Vector3.new(10, 2, 20))
			expect(part.CanCollide).to.equal(false)
			expect(part.CanQuery).to.equal(false)
			expect(part.CanTouch).to.equal(false)
			expect(part.Massless).to.equal(true)
			expect(part.Transparency).to.equal(1)
			Art.setHidden(a, false)
			expect(math.abs(part.Transparency - 0.35) < 0.0001).to.equal(true)
			expect(a.Transparency).to.equal(1)
			a.CFrame = CFrame.new(30, 4, 20)
			task.wait()
			expect(part.Position).to.equal(Vector3.new(30, 2, 20))
			a.Anchored = false
			task.wait()
			expect(part.Anchored).to.equal(false)
			expect(part:FindFirstChildWhichIsA("WeldConstraint").Part0).to.equal(a)
			Art.detach(a)
			expect(a.Transparency).to.equal(0)
			expect(visual.Parent).to.equal(nil)
		end)
		it("preserves grip attachments, does not mutate sources, and restores replaced visuals", function()
			local source = template("art-spec-map-a", "monitor")
			local sourcePart = source:FindFirstChildWhichIsA("BasePart", true)
			local grip = Instance.new("Attachment")
			grip.Name = "CarryGripLeft"
			grip.Position = Vector3.new(0.5, 0, 0)
			grip.Parent = sourcePart
			local a = root(mapA)
			a.Transparency = 0.5
			local first = Art.attach(a, "cargo", "monitor")
			expect(first:FindFirstChild("CarryGripLeft", true).Position).to.equal(Vector3.new(1, 0, 0))
			expect(sourcePart.Size).to.equal(Vector3.new(2, 2, 2))
			expect(sourcePart.CanCollide).to.equal(true)
			expect(sourcePart:FindFirstChildWhichIsA("WeldConstraint")).to.equal(nil)
			expect(Art.attach(a, "cargo", "monitor", "absent-spec-kit")).to.equal(nil)
			expect(first.Parent).to.equal(a)
			local second = Art.attach(a, "cargo", "monitor")
			expect(first.Parent).to.equal(nil)
			expect(#a:GetChildren()).to.equal(1)
			second:Destroy()
			task.wait()
			expect(a.Transparency).to.equal(0.5)
			expect(#a:GetChildren()).to.equal(0)
			Art.setHidden(a, true)
			expect(a.Transparency).to.equal(0.5)
		end)
		it("supports authored PrimaryPart pivots, rotation, and root destruction", function()
			local source = template("art-spec-map-a", "monitor")
			local sourcePart = source:FindFirstChildWhichIsA("BasePart", true)
			source.PrimaryPart = sourcePart
			sourcePart.PivotOffset = CFrame.new(0, -1, 0)
			local a = root(mapA)
			a.CFrame *= CFrame.Angles(0, math.pi / 2, 0)
			local visual = Art.attach(a, "cargo", "monitor")
			expect((visual:GetPivot().Position - Vector3.new(10, 0, 20)).Magnitude < 0.0001).to.equal(true)
			expect((visual:GetPivot().LookVector - a.CFrame.LookVector).Magnitude < 0.0001).to.equal(true)
			a:Destroy()
			task.wait()
			expect(visual.Parent).to.equal(nil)
			Art.detach(a)
		end)
		it("preserves a doorway's clear opening independently of its frame proxy", function()
			local source = template("art-spec-map-a", "wallDoorway")
			source:FindFirstChildWhichIsA("BasePart"):Destroy()
			for _, x in { -0.75, 0.75 } do
				local jamb = Instance.new("Part")
				jamb.Size = Vector3.new(0.5, 2, 2)
				jamb.CFrame = CFrame.new(x, 1, 0)
				jamb.Parent = source
			end
			source.Parent = folder(folder(kitRoot, "art-spec-map-a"), "building")
			source:SetAttribute("OpeningWidth", 1)
			local a = root(mapA)
			a:SetAttribute("ArtOpeningWidth", 3)
			local visual = Art.attach(a, "building", "wallDoorway")
			local jambs = {}
			for _, child in visual:GetChildren() do
				if child:IsA("BasePart") then
					table.insert(jambs, child)
				end
			end
			local gap = math.abs(jambs[1].Position.X - jambs[2].Position.X) - (jambs[1].Size.X + jambs[2].Size.X) / 2
			expect(gap).to.equal(3)
			expect(a.Size).to.equal(Vector3.new(4, 8, 6))
			for _, desired in { -1, 0, math.huge, "bad" } do
				a:SetAttribute("ArtOpeningWidth", desired)
				expect(Art.attach(a, "building", "wallDoorway")).to.equal(nil)
				expect(visual.Parent).to.equal(a)
			end
			a:SetAttribute("ArtOpeningWidth", 3)
			source:SetAttribute("OpeningWidth", nil)
			expect(Art.attach(a, "building", "wallDoorway")).to.equal(nil)
			expect(visual.Parent).to.equal(a)
		end)
		it("stretches a floor to the entire proxy extent", function()
			local source = template("art-spec-map-a", "floorTile")
			source.Parent = folder(folder(kitRoot, "art-spec-map-a"), "building")
			local a = root(mapA)
			a.Size = Vector3.new(40, 1, 60)
			local visual = Art.attach(a, "building", "floorTile")
			expect(visual:FindFirstChildWhichIsA("BasePart", true).Size).to.equal(a.Size)
		end)
		it("flags a solid building or furniture proxy as a camera occluder while its art shows", function()
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local ATTRIBUTE = require(ReplicatedStorage.Shared.Features.Camera.Data.CameraOccluderConstants).ATTRIBUTE
			for _, family in { "building", "furniture" } do
				local source = template("art-spec-map-a", "solid" .. family)
				source.Parent = folder(folder(kitRoot, "art-spec-map-a"), family)
			end
			template("art-spec-map-a", "monitor")
			local wall = root(mapA)
			Art.attach(wall, "building", "solidbuilding")
			expect(wall:GetAttribute(ATTRIBUTE)).to.equal(true)
			Art.setHidden(wall, true)
			expect(wall:GetAttribute(ATTRIBUTE)).to.equal(nil)
			Art.setHidden(wall, false)
			expect(wall:GetAttribute(ATTRIBUTE)).to.equal(true)
			Art.detach(wall)
			expect(wall:GetAttribute(ATTRIBUTE)).to.equal(nil)

			local cabinet = root(mapA)
			expect(Art.attach(cabinet, "furniture", "solidfurniture")).never.to.equal(nil)
			expect(cabinet:GetAttribute(ATTRIBUTE)).to.equal(true)

			-- A see-through prop (non-colliding) and cargo (carried, loose) never stop the camera.
			local prop = root(mapA)
			prop.CanCollide = false
			Art.attach(prop, "furniture", "solidfurniture")
			expect(prop:GetAttribute(ATTRIBUTE)).to.equal(nil)
			local cargo = root(mapA)
			Art.attach(cargo, "cargo", "monitor")
			expect(cargo:GetAttribute(ATTRIBUTE)).to.equal(nil)
		end)
	end)
	it("normalizes an authored positive-Z front within a rotated root without changing its source", function()
		local source = template("art-spec-map-a", "monitor")
		source:SetAttribute("FrontAxis", "PositiveZ")
		local sourcePart = source:FindFirstChildWhichIsA("BasePart", true)
		local original = sourcePart.CFrame
		local a = root(mapA)
		a.CFrame *= CFrame.Angles(0, math.pi / 2, 0)
		local visual = Art.attach(a, "cargo", "monitor")
		local part = visual:FindFirstChildWhichIsA("BasePart", true)
		expect(part.CFrame.ZVector:Dot(a.CFrame.LookVector) > 0.99).to.equal(true)
		expect(sourcePart.CFrame).to.equal(original)
		expect(source:GetAttribute("FrontAxis")).to.equal("PositiveZ")
		Art.detach(a)
		source:SetAttribute("FrontAxis", "NegativeZ")
		local unchanged = Art.attach(a, "cargo", "monitor"):FindFirstChildWhichIsA("BasePart", true)
		expect(unchanged.CFrame.LookVector:Dot(a.CFrame.LookVector) > 0.99).to.equal(true)
	end)
end
