return function()
	local Rules = require(script.Parent.ArtKitRules)
	local function template()
		local model = Instance.new("Model")
		model:SetAttribute("RuntimeApproved", true)
		model:SetAttribute("BaseSize", Vector3.new(2, 2, 2))
		local part = Instance.new("Part")
		part.Size = Vector3.new(2, 2, 2)
		part.CFrame = CFrame.new(0, 1, 0)
		part.Parent = model
		model.WorldPivot = CFrame.new()
		return model
	end
	describe("ArtKitRules", function()
		it("accepts safe approved geometry and rejects empty or invalid metadata", function()
			local model = template()
			expect(Rules.validateTemplate(model, "cargo")).to.equal(true)
			model:SetAttribute("RuntimeApproved", false)
			expect(Rules.validateTemplate(model, "cargo")).to.equal(false)
			model:SetAttribute("RuntimeApproved", true)
			model:SetAttribute("BaseSize", Vector3.zero)
			expect(Rules.validateTemplate(model, "cargo")).to.equal(false)
			model:Destroy()
		end)
		it("rejects executable and gameplay descendants", function()
			for _, class in { "Script", "ModuleScript", "Humanoid", "ProximityPrompt", "WeldConstraint" } do
				local model = template()
				Instance.new(class).Parent = model
				expect(Rules.validateTemplate(model, "cargo")).to.equal(false)
				model:Destroy()
			end
		end)
		it("rejects empty templates, inaccurate metadata and displaced base pivots", function()
			local empty = Instance.new("Model")
			empty:SetAttribute("RuntimeApproved", true)
			empty:SetAttribute("BaseSize", Vector3.new(2, 2, 2))
			expect(Rules.validateTemplate(empty, "cargo")).to.equal(false)
			empty:Destroy()
			local model = template()
			model.WorldPivot = CFrame.new(0, 1, 0)
			expect(Rules.validateTemplate(model, "cargo")).to.equal(false)
			model.WorldPivot = CFrame.new()
			model:SetAttribute("BaseSize", Vector3.new(2, 20, 2))
			expect(Rules.validateTemplate(model, "cargo")).to.equal(false)
			model:Destroy()
		end)
		it("rejects invalid doorway opening metadata", function()
			local model = template()
			for _, opening in { -1, 0, 3, math.huge, "bad" } do
				model:SetAttribute("OpeningWidth", opening)
				expect(Rules.validateTemplate(model, "building")).to.equal(false)
			end
			model:SetAttribute("OpeningWidth", 1)
			expect(Rules.validateTemplate(model, "building")).to.equal(true)
			model:Destroy()
		end)
		it("requires building coverage fit and safe identifiers", function()
			local model = template()
			expect(Rules.fitMode(model, "building")).to.equal("Stretch")
			model:SetAttribute("FitMode", "Uniform")
			expect(Rules.validateTemplate(model, "building")).to.equal(false)
			expect(Rules.validKitId("map-a")).to.equal(true)
			expect(Rules.validKitId("../map")).to.equal(false)
			model:Destroy()
		end)
	end)
end
