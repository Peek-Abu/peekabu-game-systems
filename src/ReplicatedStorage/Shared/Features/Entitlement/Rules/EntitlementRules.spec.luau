local EntitlementRules = require(script.Parent.EntitlementRules)

local function fresh()
	return { owned = {} }
end

return function()
	describe("grant / owns / revoke", function()
		it("grants once and reports ownership", function()
			local entitlements = fresh()
			expect(EntitlementRules.owns(entitlements, "suit", "hazmat")).to.equal(false)
			expect(EntitlementRules.grant(entitlements, "suit", "hazmat")).to.equal(true)
			expect(EntitlementRules.grant(entitlements, "suit", "hazmat")).to.equal(false)
			expect(EntitlementRules.owns(entitlements, "suit", "hazmat")).to.equal(true)
			expect(EntitlementRules.owns(entitlements, "skin", "hazmat")).to.equal(false)
		end)

		it("revokes, dropping an emptied category", function()
			local entitlements = fresh()
			EntitlementRules.grant(entitlements, "suit", "hazmat")
			expect(EntitlementRules.revoke(entitlements, "suit", "hazmat")).to.equal(true)
			expect(EntitlementRules.revoke(entitlements, "suit", "hazmat")).to.equal(false)
			expect(entitlements.owned.suit).to.equal(nil)
		end)

		it("lists a category's owned ids sorted", function()
			local entitlements = fresh()
			EntitlementRules.grant(entitlements, "skin", "b")
			EntitlementRules.grant(entitlements, "skin", "a")
			local ids = EntitlementRules.ownedIn(entitlements, "skin")
			expect(ids[1]).to.equal("a")
			expect(ids[2]).to.equal("b")
			expect(#EntitlementRules.ownedIn(entitlements, "none")).to.equal(0)
		end)
	end)

	describe("validate", function()
		it("accepts a well-formed slice, including unknown ids", function()
			local entitlements = fresh()
			EntitlementRules.grant(entitlements, "retired-category", "retired-id")
			expect(EntitlementRules.validate(entitlements)).to.equal(true)
		end)

		it("rejects malformed structure", function()
			expect(EntitlementRules.validate({ owned = "x" })).to.equal(false)
			expect(EntitlementRules.validate({ owned = { suit = "hazmat" } })).to.equal(false)
			expect(EntitlementRules.validate({ owned = { suit = { hazmat = false } } })).to.equal(false)
			expect(EntitlementRules.validate({ owned = { [""] = { a = true } } })).to.equal(false)
			expect(EntitlementRules.validate({ owned = { suit = { [string.rep("x", 65)] = true } } })).to.equal(false)
		end)
	end)

	describe("isKey", function()
		it("accepts 1-64 character strings only", function()
			expect(EntitlementRules.isKey("a")).to.equal(true)
			expect(EntitlementRules.isKey(string.rep("a", 64))).to.equal(true)
			expect(EntitlementRules.isKey("")).to.equal(false)
			expect(EntitlementRules.isKey(string.rep("a", 65))).to.equal(false)
		end)
	end)
end
