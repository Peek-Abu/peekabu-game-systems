{
  "name": "venture",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Packages": {
        "$path": "Packages"
      },
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Workspace": {
      "$properties": {
        "Retargeting": "Disabled"
      }
    },
    "VoiceChatService": {
      "$properties": {
        "EnableDefaultVoice": false,
        "UseAudioApi": "Enabled"
      }
    },
    "TextChatService": {
      "$properties": {
        "CreateDefaultTextChannels": true
      },
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": false
        }
      }
    }
  }
}
